package selfimprovementtermination
namespace meta

entity TerminationInput id "gooo://meta/termination/input"
entity TerminationCase id "gooo://meta/termination/case"
entity RunStep id "gooo://meta/termination/run-step"
entity StateRelation id "gooo://meta/termination/state-relation"
entity CycleWitness id "gooo://meta/termination/cycle-witness"
entity DivergenceWitness id "gooo://meta/termination/divergence-witness"
entity TerminationClaim id "gooo://meta/termination/claim"
entity TerminationReceipt id "gooo://meta/termination/receipt"
entity IndependentJudgement id "gooo://meta/termination/independent-judgement"

entity Producer id "gooo://meta/termination/producer/selfimprovementtermination"
entity Consumer id "gooo://meta/termination/consumer/self-improvement-cycle"
entity MetaOperation id "gooo://meta/termination/operation/prove-termination"
entity ProofChoice id "gooo://meta/termination/proof/termination"
entity TraceStage id "gooo://meta/termination/stage/meta-run"
entity ClaimTransitionStage id "gooo://meta/termination/stage/claim"

activity FixedPointCase(TerminationInput) -> TerminationCase computes "termination-case/v2|id=fixed-point|max_steps=4|upstream=NO_CHANGE|trace=1,state-a,state-a,4,4,NO_CHANGE,NO_CHANGE_FIXED_POINT_OBSERVED"
activity CycleTwoCase(TerminationInput) -> TerminationCase computes "termination-case/v2|id=cycle-2|max_steps=4|upstream=CHANGED|trace=1,state-a,state-b,1,2,CHANGED,METAPROGRAM_STATE_CHANGED;2,state-b,state-a,2,1,CHANGED,METAPROGRAM_STATE_CHANGED"
activity InProgressCase(TerminationInput) -> TerminationCase computes "termination-case/v2|id=in-progress|max_steps=4|upstream=CHANGED|trace=1,state-a,state-b,3,4,CHANGED,METAPROGRAM_STATE_CHANGED;2,state-b,state-c,4,4,CHANGED,METAPROGRAM_STATE_CHANGED"
activity DivergencePossibleCase(TerminationInput) -> TerminationCase computes "termination-case/v2|id=divergence-possible|max_steps=2|upstream=CHANGED|trace=1,state-a,state-b,1,2,CHANGED,METAPROGRAM_STATE_CHANGED;2,state-b,state-c,2,3,CHANGED,METAPROGRAM_STATE_CHANGED"
activity UnknownUpstreamCase(TerminationInput) -> TerminationCase computes "termination-case/v2|id=unknown-upstream|max_steps=4|upstream=FUTURE_DECISION|trace=1,state-a,state-a,4,4,NO_CHANGE,NO_CHANGE_FIXED_POINT_OBSERVED"
activity SemanticTraceIntervention(TerminationCase) -> TerminationReceipt computes "termination-intervention/v1|id=semantic-trace|stage=INTERVENTION|step=1|reason=SEMANTIC_TRACE_INTERVENTION_CHANGES_SEMANTIC_DIGEST"
activity NonsemanticCommentIntervention(TerminationCase) -> TerminationReceipt computes "termination-intervention/v1|id=nonsemantic-comment|stage=INTERVENTION|step=2|reason=NONSEMANTIC_COMMENT_INTERVENTION_PRESERVES_SEMANTIC_DIGEST"

activity ObserveMetaRun(TerminationInput) -> RunStep computes "selfimprovementtermination.Observe"
activity CompareState(RunStep) -> StateRelation computes "selfimprovementtermination.Compare"
activity DetectCycle(StateRelation) -> CycleWitness computes "selfimprovementtermination.DetectCycle"
activity BoundDivergence(StateRelation) -> DivergenceWitness computes "selfimprovementtermination.BoundDivergence"
activity ClassifyTermination(CycleWitness, DivergenceWitness) -> TerminationClaim computes "selfimprovementtermination.Classify"
activity EmitTerminationReceipt(TerminationClaim) -> TerminationReceipt computes "selfimprovementtermination.EmitReceipt"
activity JudgeTermination(TerminationReceipt) -> IndependentJudgement computes "selfimprovementtermination.IndependentJudge"
