package selfimprovementexecutiongrant
namespace selfimprovementexecutiongrant

policy SeparateExecutionGrant id "gooo://self-improvement/execution-grant/v2" {
    state "EXACT_SYSTEM_GRANT"
    state "DETERMINISTIC_REPLAY"
    state "INDEPENDENT_SYSTEM_REPLAY"
    state "MISSING_UPSTREAM_ARTIFACT"
    state "INCOMPLETE_V24_EVIDENCE"
    state "UNKNOWN_V25_CONTRACT"
    state "DIGEST_OR_SCOPE_MISMATCH"
    state "UNSAFE_EXECUTION_ENVELOPE"
    state "CONTRADICTORY_UPSTREAM_EVIDENCE"
    state "CLOSED"
    state "UNKNOWN"
    state "REFUTED"

    transition "EXACT_SYSTEM_GRANT" -> "CLOSED"
    transition "DETERMINISTIC_REPLAY" -> "CLOSED"
    transition "INDEPENDENT_SYSTEM_REPLAY" -> "CLOSED"
    transition "MISSING_UPSTREAM_ARTIFACT" -> "UNKNOWN"
    transition "INCOMPLETE_V24_EVIDENCE" -> "UNKNOWN"
    transition "UNKNOWN_V25_CONTRACT" -> "UNKNOWN"
    transition "DIGEST_OR_SCOPE_MISMATCH" -> "REFUTED"
    transition "UNSAFE_EXECUTION_ENVELOPE" -> "REFUTED"
    transition "CONTRADICTORY_UPSTREAM_EVIDENCE" -> "REFUTED"

    case "EXACT_SYSTEM_GRANT" {
        evidence "bundle" "system evaluation binds exact closed v24 and v25 evidence plus the retrieved source artifact"
        resolution {
            decision "CLOSED"
            stage "GRANT"
            step "1"
            reason "EXECUTION_GRANT_GRANTED_UNCONSUMED"
            decision_stage "GRANT"
            decision_step "1"
            decision_reason "EXECUTION_GRANT_GRANTED_UNCONSUMED"
            role "SYSTEM"
            meta_operation "derive-one-use-execution-grant"
            proof_choice "EXACT_TYPED_BINDING"
            claim "grant-allows-future-bounded-execution-only"
        }
    }
    case "DETERMINISTIC_REPLAY" {
        evidence "replay" "same typed upstream bundle derives the same unconsumed system grant"
        resolution {
            decision "CLOSED"
            stage "REPLAY"
            step "2"
            reason "EXECUTION_GRANT_GRANTED_UNCONSUMED"
            decision_stage "REPLAY"
            decision_step "2"
            decision_reason "EXECUTION_GRANT_GRANTED_UNCONSUMED"
            role "SYSTEM"
            meta_operation "replay-system-execution-grant"
            proof_choice "INDEPENDENT_REPLAY"
            claim "grant-receipt-byte-stable"
        }
    }
    case "INDEPENDENT_SYSTEM_REPLAY" {
        evidence "consumer" "independent verification recomputes eligibility and checks the receipt digest"
        resolution {
            decision "CLOSED"
            stage "VERIFY"
            step "3"
            reason "EXECUTION_GRANT_GRANTED_UNCONSUMED"
            decision_stage "VERIFY"
            decision_step "3"
            decision_reason "EXECUTION_GRANT_GRANTED_UNCONSUMED"
            role "CONSUMER"
            meta_operation "verify-system-derived-grant"
            proof_choice "INDEPENDENT_REPLAY"
            claim "system-evidence-verified"
        }
    }
    case "MISSING_UPSTREAM_ARTIFACT" {
        evidence "artifact" "v25 source artifact is missing, expired, or cannot be retrieved"
        resolution {
            decision "UNKNOWN"
            stage "BIND"
            step "4"
            reason "MISSING_OR_EXPIRED_UPSTREAM_ARTIFACT"
            decision_stage "RESOLVE"
            decision_step "4"
            decision_reason "MISSING_OR_EXPIRED_UPSTREAM_ARTIFACT"
            unknown_class "UPSTREAM_ARTIFACT_UNAVAILABLE"
            next_operation "restore-exact-upstream-artifact"
            blocked_by "upstream_artifact"
            role "CONSUMER"
            meta_operation "bind-source-artifact"
            proof_choice "EXACT_ARTIFACT_IDENTITY"
            claim "source-artifact-bound"
        }
    }
    case "INCOMPLETE_V24_EVIDENCE" {
        evidence "v24" "candidate eligibility request or system resolution is absent"
        resolution {
            decision "UNKNOWN"
            stage "BIND"
            step "5"
            reason "INCOMPLETE_EXECUTION_GRANT_INPUT"
            decision_stage "RESOLVE"
            decision_step "5"
            decision_reason "INCOMPLETE_EXECUTION_GRANT_INPUT"
            unknown_class "INCOMPLETE_EVIDENCE"
            next_operation "restore-v24-system-evidence"
            blocked_by "v24_authorization_resolution"
            role "CONSUMER"
            meta_operation "bind-v24-system-evidence"
            proof_choice "SIX_FIELD_UNKNOWN"
            claim "v24-evidence-bound"
        }
    }
    case "UNKNOWN_V25_CONTRACT" {
        evidence "v25" "pre-execution contract cannot establish a closed bounded candidate"
        resolution {
            decision "UNKNOWN"
            stage "UPSTREAM"
            step "6"
            reason "V25_PRE_EXECUTION_CONTRACT_UNKNOWN"
            decision_stage "RESOLVE"
            decision_step "6"
            decision_reason "V25_PRE_EXECUTION_CONTRACT_UNKNOWN"
            unknown_class "UPSTREAM_UNKNOWN"
            next_operation "resolve-v25-pre-execution-contract"
            blocked_by "v25_pre_execution_contract"
            role "CONSUMER"
            meta_operation "bind-v25-contract"
            proof_choice "SIX_FIELD_UNKNOWN"
            claim "v25-contract-bound"
        }
    }
    case "DIGEST_OR_SCOPE_MISMATCH" {
        evidence "binding" "candidate, contract, operation, scope, or request digests disagree"
        resolution {
            decision "REFUTED"
            stage "BIND"
            step "7"
            reason "EXECUTION_GRANT_SCOPE_BINDING_MISMATCH"
            decision_stage "RESOLVE"
            decision_step "7"
            decision_reason "EXECUTION_GRANT_SCOPE_BINDING_MISMATCH"
            role "SYSTEM"
            meta_operation "refute-grant-scope-binding"
            proof_choice "CONTRADICTION_DOMINATES"
            claim "grant-scope-bound"
        }
    }
    case "UNSAFE_EXECUTION_ENVELOPE" {
        evidence "safety" "unbounded runs, writes, or execution authority are not accepted by the separate grant"
        resolution {
            decision "REFUTED"
            stage "SAFETY"
            step "8"
            reason "UNAUTHORIZED_OR_UNSAFE_EXECUTION_GRANT"
            decision_stage "RESOLVE"
            decision_step "8"
            decision_reason "UNAUTHORIZED_OR_UNSAFE_EXECUTION_GRANT"
            role "SYSTEM"
            meta_operation "refute-unsafe-execution-envelope"
            proof_choice "DEFAULT_DENY"
            claim "unconsumed-grant-safety-bound"
        }
    }
    case "CONTRADICTORY_UPSTREAM_EVIDENCE" {
        evidence "upstream" "v24 and v25 must agree on candidate identity and bounded operation"
        resolution {
            decision "REFUTED"
            stage "UPSTREAM"
            step "9"
            reason "UPSTREAM_EVIDENCE_CONTRADICTION"
            decision_stage "RESOLVE"
            decision_step "9"
            decision_reason "UPSTREAM_EVIDENCE_CONTRADICTION"
            role "SYSTEM"
            meta_operation "refute-contradictory-upstream-evidence"
            proof_choice "CONTRADICTION_DOMINATES"
            claim "upstream-evidence-consistent"
        }
    }
}
