package ambiguitybudget
namespace ambiguitybudget

entity InterpretationCandidate id "gooo://ambiguity-budget/entity/interpretation-candidate"
entity UnresolvedBranch id "gooo://ambiguity-budget/entity/unresolved-branch"
entity EvidencePath id "gooo://ambiguity-budget/entity/evidence-path"
entity AmbiguityReceipt id "gooo://ambiguity-budget/entity/ambiguity-receipt"

activity FixedBudget() -> AmbiguityReceipt computes "ambiguity-budget:budget:2,1,2"
activity ZeroAmbiguity() -> AmbiguityReceipt computes "ambiguity-budget:case:zero-ambiguity:ZERO:KNOWN:1,0,1"
activity BoundaryAmbiguity() -> AmbiguityReceipt computes "ambiguity-budget:case:boundary-ambiguity:BOUNDARY:KNOWN:2,1,2"
activity OverBudgetAmbiguity() -> AmbiguityReceipt computes "ambiguity-budget:case:over-budget-ambiguity:OVER:KNOWN:3,2,3"
activity UnknownAmbiguity() -> AmbiguityReceipt computes "ambiguity-budget:case:unknown-ambiguity:UNKNOWN:UNKNOWN:2,1,2"
