package reflectivequerysandbox
namespace reflectivequerysandbox

entity QuerySubject id "gooo://reflective-query-sandbox/subject/query"
entity StructureProjection id "gooo://reflective-query-sandbox/subject/structure"
entity ClaimPriorOpen id "gooo://reflective-query-sandbox/claim-state/open"
entity MetricReadRelation id "gooo://reflective-query-sandbox/metric/relation/read-only"
entity QueryReceipt id "gooo://reflective-query-sandbox/receipt/query"
entity MutationRequest id "gooo://reflective-query-sandbox/mutation/request"
entity MutationField id "gooo://reflective-query-sandbox/mutation/field/id"
entity MutationPayload id "gooo://reflective-query-sandbox/mutation/payload/identity-preserving"
entity MutationIntent id "gooo://reflective-query-sandbox/mutation/intent/reflective-query-sandbox"
entity MutationLocality id "gooo://reflective-query-sandbox/mutation/locality/detached-observation-copy"
entity RepositoryStatusNet id "gooo://reflective-query-sandbox/repository/status/net_repository_status_unchanged"
entity RefinementProposal id "gooo://reflective-query-sandbox/proposal/refinement"
entity UnknownRefinementPolicy id "gooo://reflective-query-sandbox/proposal/policy/unknown-preserve-open"
entity ProposalAuthorityNone id "gooo://reflective-query-sandbox/proposal/authority/NONE"
entity ProposalMetaOperation id "gooo://reflective-query-sandbox/proposal/meta-operation/refinement-proposal"

entity OutcomeStructure id "gooo://reflective-query-sandbox/claim/outcome/structure/query-relation-exact/foundation/query-self-structure/reflect.structure/open"
entity OutcomeClaims id "gooo://reflective-query-sandbox/claim/outcome/claims/query-relation-exact/coherence/query-self-claims/reflect.claims/open"
entity OutcomeMetrics id "gooo://reflective-query-sandbox/claim/outcome/metrics/query-relation-exact/regression/query-self-metrics/reflect.metrics/open"
entity OutcomeImmutableIDPatchRejected id "gooo://reflective-query-sandbox/claim/outcome/immutable-id-patch-rejected/immutable-id-patch-rejected/foundation/deny-immutable-id-patch/mutation.attempt/open"
entity DriverSemanticSnapshot id "gooo://reflective-query-sandbox/claim/driver/semantic-snapshot/semantic-digest-equal/coherence/bind-semantic-snapshot/reflect.structure/open"
entity DriverQueryProjection id "gooo://reflective-query-sandbox/claim/driver/query-projection/query-projection-stable/regression/project-read-only-query-view/reflect.claims/open"
entity DriverQueryReceipts id "gooo://reflective-query-sandbox/claim/driver/query-receipts/receipt-observation-digest-verified/foundation/seal-query-receipts/receipt.seal/open"
entity DriverClaimLedger id "gooo://reflective-query-sandbox/claim/driver/claim-ledger/claim-ledger-chained/coherence/transition-claim-ledger/reflect.metrics/open"
entity GuardrailUnknownClosed id "gooo://reflective-query-sandbox/claim/guardrail/unknown-closed/unknown-subject-preserved/regression/preserve-unknown-target/unknown.target/open"
entity GuardrailGraphUnchanged id "gooo://reflective-query-sandbox/claim/guardrail/graph-unchanged/graph-digest-equal/foundation/compare-query-graph-digest/reflect.structure/open"
entity GuardrailRepositoryWriteSet id "gooo://reflective-query-sandbox/claim/guardrail/repository-net-unchanged/net-repository-status-unchanged/coherence/observe-repository-net-status/repository.net-status-unchanged/open"
entity GuardrailImmutableIDPatchAcceptedFalse id "gooo://reflective-query-sandbox/claim/guardrail/immutable-id-patch/immutable-id-patch-accepted-false/regression/bind-immutable-id-patch-rejection/mutation.attempt/open"

activity ReflectStructure(QuerySubject, StructureProjection, OutcomeStructure, DriverSemanticSnapshot, GuardrailGraphUnchanged) -> QueryReceipt computes "reflect.query:structure"
activity ReflectClaims(QuerySubject, ClaimPriorOpen, OutcomeClaims, DriverQueryProjection, GuardrailUnknownClosed) -> QueryReceipt computes "reflect.query:claims"
activity ReflectMetrics(QuerySubject, MetricReadRelation, OutcomeMetrics, DriverClaimLedger) -> QueryReceipt computes "reflect.query:metrics"
activity AttemptMutation(QuerySubject, MutationRequest, MutationField, MutationPayload, MutationIntent, MutationLocality, OutcomeImmutableIDPatchRejected, GuardrailImmutableIDPatchAcceptedFalse) -> QueryReceipt computes "reflect.attempt:mutation"
activity SealQueryReceipt(QueryReceipt, DriverQueryReceipts) -> QueryReceipt computes "reflect.observation:receipt-seal"
activity ObserveRepositoryNet(QuerySubject, RepositoryStatusNet, GuardrailRepositoryWriteSet) -> QueryReceipt computes "reflect.observation:net-repository-status-unchanged"
activity ProposeRefinement(QueryReceipt, UnknownRefinementPolicy, ProposalAuthorityNone, ProposalMetaOperation) -> RefinementProposal computes "reflect.meta:proposal:refine-unknown"
