package reflectivequerysandbox
namespace reflectivequerysandbox

entity QuerySubject id "gooo://reflective-query-sandbox/subject/query"
entity StructureProjection id "gooo://reflective-query-sandbox/subject/structure"
entity ClaimPriorOpen id "gooo://reflective-query-sandbox/claim-state/open"
entity MetricReadRelation id "gooo://reflective-query-sandbox/metric/relation/read-only"
entity QueryReceipt id "gooo://reflective-query-sandbox/receipt/query"
entity MutationRequest id "gooo://reflective-query-sandbox/mutation/request"

entity OutcomeStructure id "gooo://reflective-query-sandbox/claim/outcome/structure/foundation/query-self-structure/reflect.structure/open"
entity OutcomeClaims id "gooo://reflective-query-sandbox/claim/outcome/claims/coherence/query-self-claims/reflect.claims/open"
entity OutcomeMetrics id "gooo://reflective-query-sandbox/claim/outcome/metrics/regression/query-self-metrics/reflect.metrics/open"
entity OutcomeMutationDenied id "gooo://reflective-query-sandbox/claim/outcome/mutation-denied/foundation/deny-mutation-request/mutation.attempt/open"
entity DriverSemanticSnapshot id "gooo://reflective-query-sandbox/claim/driver/semantic-snapshot/coherence/bind-semantic-snapshot/reflect.structure/open"
entity DriverQueryProjection id "gooo://reflective-query-sandbox/claim/driver/query-projection/regression/project-read-only-query-view/reflect.claims/open"
entity DriverQueryReceipts id "gooo://reflective-query-sandbox/claim/driver/query-receipts/foundation/seal-query-receipts/receipt.seal/open"
entity DriverClaimLedger id "gooo://reflective-query-sandbox/claim/driver/claim-ledger/coherence/transition-claim-ledger/reflect.metrics/open"
entity GuardrailUnknownClosed id "gooo://reflective-query-sandbox/claim/guardrail/unknown-closed/regression/preserve-unknown-target/unknown.target/open"
entity GuardrailGraphUnchanged id "gooo://reflective-query-sandbox/claim/guardrail/graph-unchanged/foundation/compare-query-graph-digest/reflect.structure/open"
entity GuardrailRepositoryWriteSet id "gooo://reflective-query-sandbox/claim/guardrail/repository-write-set/coherence/observe-repository-write-set/mutation.attempt/open"
entity GuardrailMutationAuthority id "gooo://reflective-query-sandbox/claim/guardrail/mutation-authority/regression/bind-mutation-authority/mutation.attempt/open"

activity ReflectStructure(QuerySubject, StructureProjection, OutcomeStructure, DriverSemanticSnapshot, GuardrailGraphUnchanged) -> QueryReceipt computes "reflect.query:structure"
activity ReflectClaims(QuerySubject, ClaimPriorOpen, OutcomeClaims, DriverQueryProjection, GuardrailUnknownClosed) -> QueryReceipt computes "reflect.query:claims"
activity ReflectMetrics(QuerySubject, MetricReadRelation, OutcomeMetrics, DriverClaimLedger) -> QueryReceipt computes "reflect.query:metrics"
activity AttemptMutation(QuerySubject, MutationRequest, OutcomeMutationDenied, GuardrailRepositoryWriteSet, GuardrailMutationAuthority) -> QueryReceipt computes "reflect.attempt:mutation"
activity SealQueryReceipt(QueryReceipt, DriverQueryReceipts) -> QueryReceipt computes "reflect.observation:receipt-seal"
