package directmoduleimpact
namespace directmoduleimpact

// Go observes the downloaded module and exact source preimages. Gooo decides
// whether those observations close a detached direct-module change proposal.
entity ModuleIdentity id "urn:gooo:direct-module-impact:identity" fields {
    field module_path id "urn:gooo:direct-module-impact:identity:path" type string required one
}

entity AffectedSurfaces id "urn:gooo:direct-module-impact:surfaces" fields {
    field go_mod id "urn:gooo:direct-module-impact:surfaces:go-mod" type string required one
    field go_sum id "urn:gooo:direct-module-impact:surfaces:go-sum" type string required one
    field policy id "urn:gooo:direct-module-impact:surfaces:policy" type string required one
    field license id "urn:gooo:direct-module-impact:surfaces:license" type string required one
    field document id "urn:gooo:direct-module-impact:surfaces:document" type string required one
}

activity RequiredSurfaces(ModuleIdentity) -> AffectedSurfaces
    id "urn:gooo:direct-module-impact:required-surfaces" computes `
let license = "licenses/gooo-decision-runtime/LICENSE"
if input.module_path == "github.com/kimjooyoon/gooo-jev" {
    license = "licenses/gooo-jev/LICENSE"
}
return AffectedSurfaces{
    go_mod: "go.mod", go_sum: "go.sum",
    policy: "internal/meta/languagereadiness/toolchainrelease/payload.gooo",
    license: license, document: "docs/language/release-payload-origins.md",
}
`

// Each rule owns one live version occurrence inside a mixed document. The
// prefix identifies that occurrence; older links in the same file remain.
entity ActiveVersionRules id "urn:gooo:direct-module-impact:active-version-rules" fields {
    field paths id "urn:gooo:direct-module-impact:active-version-rules:paths" type string required many
    field prefixes id "urn:gooo:direct-module-impact:active-version-rules:prefixes" type string required many
    field rule_ids id "urn:gooo:direct-module-impact:active-version-rules:ids" type string required many
}

activity RequiredActiveVersionRules(ModuleIdentity) -> ActiveVersionRules
    id "urn:gooo:direct-module-impact:required-active-version-rules" computes `
if input.module_path == "github.com/kimjooyoon/gooo-decision-runtime" {
    return ActiveVersionRules{
        paths: []string{"README.md"},
        prefixes: []string{"The development source pins **Go SDK "},
        rule_ids: []string{"urn:gooo:direct-module-impact:rule:live-readme-sdk"},
    }
}
return ActiveVersionRules{paths: []string{}, prefixes: []string{}, rule_ids: []string{}}
`

// These committed trees preserve observations from earlier executions. A
// current-version mention there is historical only while its bytes still
// equal the file at HEAD; Go observes that equality, not the archive role.
entity ArchiveRoots id "urn:gooo:direct-module-impact:archive-roots" fields {
    field releases id "urn:gooo:direct-module-impact:archive-roots:releases" type string required one
    field observations id "urn:gooo:direct-module-impact:archive-roots:observations" type string required one
}

activity HistoricalRoots(ModuleIdentity) -> ArchiveRoots
    id "urn:gooo:direct-module-impact:historical-roots" computes `
return ArchiveRoots{releases: "docs/releases/", observations: "docs/observations/"}
`

entity ModuleProposal id "urn:gooo:direct-module-impact:proposal" fields {
    field module_path id "urn:gooo:direct-module-impact:proposal:module" type string required one
    field current_version id "urn:gooo:direct-module-impact:proposal:current" type string required one
    field proposed_version id "urn:gooo:direct-module-impact:proposal:proposed" type string required one
    field go_mod_sha256 id "urn:gooo:direct-module-impact:proposal:go-mod" type string required one
    field policy_sha256 id "urn:gooo:direct-module-impact:proposal:policy" type string required one
    field plan_sha256 id "urn:gooo:direct-module-impact:proposal:plan" type string required one
    field download_module_path id "urn:gooo:direct-module-impact:proposal:download-path" type string required one
    field download_version id "urn:gooo:direct-module-impact:proposal:download-version" type string required one
    field download_ref id "urn:gooo:direct-module-impact:proposal:download-ref" type string required one
    field module_sum id "urn:gooo:direct-module-impact:proposal:module-sum" type string required one
    field mod_sum id "urn:gooo:direct-module-impact:proposal:mod-sum" type string required one
    field license_sha256 id "urn:gooo:direct-module-impact:proposal:license" type string required one
    field current_pin_consistent id "urn:gooo:direct-module-impact:proposal:current-pin" type boolean required one
    field origin_bound id "urn:gooo:direct-module-impact:proposal:origin-bound" type boolean required one
    field sums_bound id "urn:gooo:direct-module-impact:proposal:sums-bound" type boolean required one
    field license_bound id "urn:gooo:direct-module-impact:proposal:license-bound" type boolean required one
    field observed_outputs id "urn:gooo:direct-module-impact:proposal:outputs" type integer required one
    field unresolved_outputs id "urn:gooo:direct-module-impact:proposal:unresolved" type integer required one
    field scan_scope id "urn:gooo:direct-module-impact:proposal:scan-scope" type string required one
    field tracked_paths_sha256 id "urn:gooo:direct-module-impact:proposal:tracked-paths" type string required one
    field tracked_files_scanned id "urn:gooo:direct-module-impact:proposal:tracked-files" type integer required one
    field tracked_reference_files id "urn:gooo:direct-module-impact:proposal:reference-files" type integer required one
    field outside_reference_files id "urn:gooo:direct-module-impact:proposal:outside-files" type integer required one
    field historical_reference_files id "urn:gooo:direct-module-impact:proposal:historical-files" type integer required one
    field historical_writes id "urn:gooo:direct-module-impact:proposal:historical" type integer required one
}

entity ModuleDecision id "urn:gooo:direct-module-impact:decision" fields {
    field module_path id "urn:gooo:direct-module-impact:decision:module" type string required one
    field proposed_version id "urn:gooo:direct-module-impact:decision:proposed" type string required one
    field plan_sha256 id "urn:gooo:direct-module-impact:decision:plan" type string required one
    field download_ref id "urn:gooo:direct-module-impact:decision:ref" type string required one
    field observed_outputs id "urn:gooo:direct-module-impact:decision:outputs" type integer required one
    field tracked_reference_files id "urn:gooo:direct-module-impact:decision:reference-files" type integer required one
    field outside_reference_files id "urn:gooo:direct-module-impact:decision:outside-files" type integer required one
    field historical_reference_files id "urn:gooo:direct-module-impact:decision:historical-files" type integer required one
    field status id "urn:gooo:direct-module-impact:decision:status" type string required one
}

activity AssessModuleProposal(ModuleProposal) -> ModuleDecision
    id "urn:gooo:direct-module-impact:assess" computes `
let status = "READY_FOR_DETACHED_PROJECTION"
if (input.module_path != "github.com/kimjooyoon/gooo-jev" &&
    input.module_path != "github.com/kimjooyoon/gooo-decision-runtime") ||
   input.current_version == "" || input.proposed_version == "" ||
   input.go_mod_sha256 == "" || input.policy_sha256 == "" || input.plan_sha256 == "" ||
   input.observed_outputs < 1 || input.unresolved_outputs < 0 || input.historical_writes < 0 ||
   input.scan_scope != "git-tracked-working-tree-regular-files/v1" ||
   input.tracked_paths_sha256 == "" || input.tracked_files_scanned < 1 ||
   input.tracked_reference_files < 0 || input.outside_reference_files < 0 ||
   input.historical_reference_files < 0 ||
   input.tracked_reference_files > input.tracked_files_scanned ||
   input.outside_reference_files + input.historical_reference_files > input.tracked_reference_files {
    status = "INVALID_OBSERVATION"
} else if !input.current_pin_consistent {
    status = "CURRENT_SOURCE_CONFLICT"
} else if input.download_module_path != input.module_path ||
        input.download_version != input.proposed_version ||
        input.download_ref == "" || input.module_sum == "" || input.mod_sum == "" ||
        input.license_sha256 == "" || !input.origin_bound || !input.sums_bound ||
        !input.license_bound {
    status = "UPSTREAM_ORIGIN_UNRESOLVED"
} else if input.historical_writes > 0 {
    status = "HISTORICAL_WRITE_CONFLICT"
} else if input.unresolved_outputs > 0 || input.outside_reference_files > 0 {
    status = "UNRESOLVED_OUTPUTS"
} else if input.current_version == input.proposed_version {
    status = "NO_VERSION_CHANGE"
}
return ModuleDecision{
    module_path: input.module_path,
    proposed_version: input.proposed_version,
    plan_sha256: input.plan_sha256,
    download_ref: input.download_ref,
    observed_outputs: input.observed_outputs,
    tracked_reference_files: input.tracked_reference_files,
    outside_reference_files: input.outside_reference_files,
    historical_reference_files: input.historical_reference_files,
    status: status,
}
`

// A verified detached candidate may become one Git tree/commit on a new agent
// branch. The observer supplies checkout and branch facts; this activity owns
// whether that write-bearing transition is allowed.
entity BranchCommitProposal id "urn:gooo:direct-module-impact:branch-proposal" fields {
    field plan_sha256 id "urn:gooo:direct-module-impact:branch-proposal:plan" type string required one
    field branch_name id "urn:gooo:direct-module-impact:branch-proposal:branch" type string required one
    field projected_outputs id "urn:gooo:direct-module-impact:branch-proposal:projected" type integer required one
    field verified_outputs id "urn:gooo:direct-module-impact:branch-proposal:verified" type integer required one
    field changed_outputs id "urn:gooo:direct-module-impact:branch-proposal:changed" type integer required one
    field clean_checkout id "urn:gooo:direct-module-impact:branch-proposal:clean" type boolean required one
    field base_bound id "urn:gooo:direct-module-impact:branch-proposal:base" type boolean required one
    field branch_available id "urn:gooo:direct-module-impact:branch-proposal:available" type boolean required one
    field agent_branch id "urn:gooo:direct-module-impact:branch-proposal:agent" type boolean required one
}

entity BranchCommitDecision id "urn:gooo:direct-module-impact:branch-decision" fields {
    field plan_sha256 id "urn:gooo:direct-module-impact:branch-decision:plan" type string required one
    field branch_name id "urn:gooo:direct-module-impact:branch-decision:branch" type string required one
    field status id "urn:gooo:direct-module-impact:branch-decision:status" type string required one
}

activity AssessBranchCommit(BranchCommitProposal) -> BranchCommitDecision
    id "urn:gooo:direct-module-impact:assess-branch-commit" computes `
let status = "READY_FOR_BRANCH_COMMIT"
if input.plan_sha256 == "" || input.branch_name == "" ||
   input.projected_outputs < 1 || input.verified_outputs < 0 ||
   input.changed_outputs < 1 || input.changed_outputs > input.projected_outputs ||
   input.verified_outputs > input.projected_outputs {
    status = "INVALID_BRANCH_PROPOSAL"
} else if !input.clean_checkout || !input.base_bound ||
        !input.branch_available || !input.agent_branch ||
        input.verified_outputs != input.projected_outputs {
    status = "BRANCH_COMMIT_UNRESOLVED"
}
return BranchCommitDecision{
    plan_sha256: input.plan_sha256,
    branch_name: input.branch_name,
    status: status,
}
`
