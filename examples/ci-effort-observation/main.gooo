activity ObserveCIWorkflowWindow(WorkflowWindowInput) -> WorkflowWindowOutput computes "ci.workflow.window/v1;partial-lineage-observation-permission=READ_ONLY;partial-lineage-policy=EXACT_SUBJECT_WORKFLOW_LINEAGE_CONTRACT;partial-lineage-repository=kimjooyoon/meta-ontology-go;partial-lineage-source-workflow=.github/workflows/ci.yml;partial-lineage-consumer-workflow=CI effort observation;partial-lineage-source-identity=workflow,run_id,run_attempt,subject_sha,repository,event;partial-lineage-source-identity-priority=run_id,repository,workflow,event,run_attempt,head_sha;partial-lineage-source-secondary-fields=ref,head_branch;partial-lineage-source-api-key=workflow_run.id;partial-lineage-artifact-identity=name,id,digest,run_id,run_attempt,subject_sha;partial-lineage-artifact-subject-binding=ci-evidence.head_sha;partial-lineage-consumer-identity=workflow,run_id,run_attempt,subject_sha,ref;partial-lineage-provenance-state=EXACT_REQUIRED;partial-lineage-lineage-states=EXACT,STALE,DIRECT_MISSING,MISMATCH,TAMPERED,CURRENT_DEV_FALLBACK;partial-lineage-causal-fields=stage,step,reason,unknown_class,next_operation,blocked_by;partial-lineage-edge=consumer>source-run;partial-lineage-edge=source-run>subject;partial-lineage-edge=source-run>artifact;partial-lineage-edge=artifact>attempt;partial-lineage-edge=artifact>digest;partial-lineage-edge=consumer>consumer-subject;partial-lineage-refuted-dominates-unknown=true;partial-lineage-metric=active_lineage_roots|1;partial-lineage-metric=cases_satisfied|9;partial-lineage-metric=cases_total|9;partial-lineage-metric=stale_misattributed_before|2;partial-lineage-metric=stale_misattributed_after|0;partial-lineage-metric=stale_unknown|3;partial-lineage-metric=exact_subject_bindings|3;partial-lineage-metric=unknown_classifications|3;partial-lineage-metric=unknown_six_field_preservations|3;partial-lineage-metric=contradictions_refuted|3;partial-lineage-metric=mismatch_detections|3;partial-lineage-metric=fallback_attempts|1;partial-lineage-metric=fallback_accepted|0;partial-lineage-metric=fallback_rejected|1;partial-lineage-metric=exact_replay_comparisons|1;partial-lineage-metric=source_artifact_resolutions|3;partial-lineage-metric=source_receipts|2;partial-lineage-metric=consumer_receipts|2;partial-lineage-metric=evidence_artifacts|21;partial-lineage-case=EXACT_TRIGGER_ARTIFACT_MATCH|CLOSED|EXACT||446c8451b231ed08087945ac1a7f705bea7225be|33859268902|VALUE;partial-lineage-case=EXACT_API_HEAD_SHA_NULL_REF|CLOSED|EXACT||446c8451b231ed08087945ac1a7f705bea7225be|33859268902|NULL;partial-lineage-case=EXACT_API_HEAD_SHA_EMPTY_REF|CLOSED|EXACT||446c8451b231ed08087945ac1a7f705bea7225be|33859268902|EMPTY;partial-lineage-case=STALE_SOURCE_A5697C29|UNKNOWN|STALE|STALE|a5697c29443440af1eb463de0ea6697a043c2afb|33858521448|VALUE;partial-lineage-case=SOURCE_API_MISSING|UNKNOWN|DIRECT_MISSING|DIRECT_MISSING|8a919d0a8d28a490eeac3262b9959bcdd5414caa|33858991200|VALUE;partial-lineage-case=ARTIFACT_LOOKUP_MISSING|UNKNOWN|DIRECT_MISSING|DIRECT_MISSING|a5697c29443440af1eb463de0ea6697a043c2afb|33858521448|VALUE;partial-lineage-case=SUBJECT_RUN_MISMATCH|REFUTED|CURRENT_DEV_FALLBACK||8a919d0a8d28a490eeac3262b9959bcdd5414caa|33858991200|VALUE;partial-lineage-case=TAMPERED_ARTIFACT|REFUTED|TAMPERED||446c8451b231ed08087945ac1a7f705bea7225be|33859268902|VALUE;partial-lineage-case=SOURCE_REPOSITORY_MISMATCH|REFUTED|MISMATCH||446c8451b231ed08087945ac1a7f705bea7225be|33859268902|VALUE"
activity BindVerificationOperationManifest(OperationManifestInput) -> OperationManifestOutput computes "ci.operation.manifest/v1"
activity ObserveVerificationRuntime(VerificationRuntimeInput) -> VerificationRuntimeOutput computes "ci.verification.runtime/v1;observation-permission=READ_ONLY"
activity AccountExecutedVerifications(ExecutedVerificationsInput) -> ExecutedVerificationsOutput computes "ci.verification.executed/v1"
activity AccountSkippedVerifications(SkippedVerificationsInput) -> SkippedVerificationsOutput computes "ci.verification.skipped/v1"
activity EvaluateExactEvidenceReuse(ReuseDecisionInput) -> ReuseDecisionOutput computes "ci.evidence.reuse/v1;evidence-reuse-permission=EXACT_SUCCESS_ONLY;promotion-permission=NONE"
activity RecordReuseRejectionsAndUnknowns(ReuseRejectionsUnknownInput) -> ReuseRejectionsUnknownOutput computes "ci.evidence.rejections/v1"
activity BindOpenTofuObservation(OpenTofuObservationInput) -> OpenTofuObservationOutput computes "ci.external.opentofu/v1"
