package denominatorevolution
namespace denominatorevolution

entity FixedDenominator id "gooo://denominator-evolution/entity/fixed-denominator"
entity DenominatorVersion id "gooo://denominator-evolution/entity/denominator-version"
entity ChangeReason id "gooo://denominator-evolution/entity/change-reason"
entity PredecessorEvidence id "gooo://denominator-evolution/entity/predecessor-evidence"
entity MigrationReceipt id "gooo://denominator-evolution/entity/migration-receipt"
entity ClaimTransition id "gooo://denominator-evolution/entity/claim-transition"
entity IndependentDecision id "gooo://denominator-evolution/entity/independent-decision"

// The computes payloads are the authority for this experiment. The JSON file
// is only a verification expectation and may not manufacture these values.
activity DeclareFixedDenominator(FixedDenominator) -> DenominatorVersion computes "denominator|version=gooo/measurement-denominator/v1|obligation=governance/versioned-members^The measurement basis has a stable version and exact member set.^OUTCOME^FOUNDATION^bind-fixed-denominator^FOUNDATION^pin-versioned-member-set^a version and member digest identify exactly what is measured|obligation=governance/change-reasons^Every addition and deletion has an explicit admissible reason.^DRIVER^COHERENCE^classify-change-reason^PROPOSE^record-add-delete-reason^change intent is evidence, not an inferred improvement|obligation=governance/predecessor-digest^The predecessor version and digest resolve to a known denominator.^DRIVER^FOUNDATION^bind-predecessor-digest^MIGRATE^verify-predecessor-digest^a version label without its exact predecessor digest is unknown|obligation=governance/migration-receipt^A migration receipt binds the predecessor, successor, changes, and decision.^OUTCOME^COHERENCE^accept-migration-receipt^MIGRATE^bind-receipt-to-both-versions^the receipt makes a legal denominator transition replayable|obligation=governance/legacy-summary^A human summary may not replace exact denominator members.^GUARDRAIL^REGRESSION^reject-summary-substitution^GUARD^preserve-exact-members^prose and aggregate summaries cannot authorize a basis change"
activity ProposeDenominatorChange(DenominatorVersion) -> ChangeReason computes "cases|case=legal-advance^AUTHORIZED_MIGRATION^ADVANCE^EXACT^DENOMINATOR_ADVANCE_AUTHORIZED^OPEN^DISCHARGED^COHERENCE^accept-authorized-denominator-advance^DECIDE^apply-migration-receipt^both versioned digests and every add-delete reason are bound^gooo/measurement-denominator/v1^gooo/measurement-denominator/v2|case=unauthorized-change^UNAUTHORIZED_MUTATION^BLOCK^INVARIANT_ONLY^MIGRATION_RECEIPT_MISSING^OPEN^REFUTED^REGRESSION^reject-unreceipted-denominator-change^DECIDE^reject-missing-receipt^a changed measurement basis cannot self-authorize^gooo/measurement-denominator/v1^gooo/measurement-denominator/v2|case=unknown-predecessor^UNKNOWN_PREDECESSOR^FAIL_CLOSED^LOWER_RESOLUTION^PREDECESSOR_DIGEST_UNKNOWN^OPEN^OPEN^FOUNDATION^fail-closed-unknown-predecessor^RESOLVE^lookup-predecessor^an unregistered predecessor is not a legal base^gooo/measurement-denominator/v9^gooo/measurement-denominator/v10|addition=governance/replay-receipt^NEW_MEASURABLE_OBLIGATION|deletion=governance/legacy-summary^DEPRECATED_DUPLICATE|mutation=legal-advance^governance/replay-receipt^The migration receipt replays to the same successor digest.^OUTCOME^COHERENCE^replay-migration-receipt^REPLAY^compare-successor-digest^replay is an exact check of the accepted transition|mutation=unauthorized-change^governance/improvement-rate^Infer an improvement rate from the changed denominator.^OUTCOME^FOUNDATION^estimate-improvement-rate^GUARD^infer-rate^forbidden estimate"
activity BindPredecessorDigest(DenominatorVersion) -> PredecessorEvidence computes "predecessors|known=gooo/measurement-denominator/v1|unknown=gooo/measurement-denominator/v9|successor=gooo/measurement-denominator/v2|unknown-successor=gooo/measurement-denominator/v10"
activity RecordChangeReasons(ChangeReason) -> MigrationReceipt computes "receipt|id=receipt-legal-advance|decision=ADVANCE|reason=DENOMINATOR_ADVANCE_AUTHORIZED|coordinate=MIGRATE^issue-receipt^DENOMINATOR_ADVANCE_AUTHORIZED"
activity IssueMigrationReceipt(PredecessorEvidence) -> MigrationReceipt computes "receipt-bind|predecessor=gooo/measurement-denominator/v1|successor=gooo/measurement-denominator/v2"
activity TransitionClaim(MigrationReceipt) -> ClaimTransition computes "claims|event=1^legal-advance^OPEN^DISCHARGED^DECIDE^apply-migration-receipt^DENOMINATOR_ADVANCE_AUTHORIZED|event=2^unauthorized-change^OPEN^REFUTED^DECIDE^reject-missing-receipt^MIGRATION_RECEIPT_MISSING|event=3^unknown-predecessor^OPEN^OPEN^RESOLVE^lookup-predecessor^PREDECESSOR_DIGEST_UNKNOWN|emitted=claim.legal-advance^AUTHORIZED_DECISION^DISCHARGED|emitted=claim.unauthorized-change^UNAUTHORIZED_MUTATION^REFUTED|emitted=claim.unknown-predecessor^UNKNOWN_PREDECESSOR^OPEN|emitted=claim.forbidden-estimate^FORBIDDEN_ESTIMATE^PROPOSED"
activity IndependentlyDecide(ClaimTransition) -> IndependentDecision computes "decisions|case=legal-advance^ADVANCE^EXACT^DENOMINATOR_ADVANCE_AUTHORIZED|case=unauthorized-change^BLOCK^INVARIANT_ONLY^MIGRATION_RECEIPT_MISSING|case=unknown-predecessor^FAIL_CLOSED^LOWER_RESOLUTION^PREDECESSOR_DIGEST_UNKNOWN"
