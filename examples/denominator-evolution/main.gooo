package denominatorevolution
namespace denominatorevolution

entity FixedDenominator id "gooo://denominator-evolution/entity/fixed-denominator"
entity DenominatorVersion id "gooo://denominator-evolution/entity/denominator-version"
entity ChangeReason id "gooo://denominator-evolution/entity/change-reason"
entity PredecessorEvidence id "gooo://denominator-evolution/entity/predecessor-evidence"
entity MigrationReceipt id "gooo://denominator-evolution/entity/migration-receipt"

// This source contains measurement inputs and receipt material only. Outcomes
// are derived by the programs.
activity DeclareFixedDenominator(FixedDenominator) -> DenominatorVersion computes "denominator|version=gooo/measurement-denominator/v1|obligation=governance/versioned-members^The measurement basis has a stable version and exact member set.^OUTCOME^FOUNDATION^bind-fixed-denominator^FOUNDATION^pin-versioned-member-set^a version and member digest identify exactly what is measured|obligation=governance/change-reasons^Every addition and deletion has an explicit admissible reason.^DRIVER^COHERENCE^classify-change-reason^PROPOSE^record-add-delete-reason^change intent is evidence, not an inferred improvement|obligation=governance/predecessor-digest^The predecessor version and digest resolve to a known denominator.^DRIVER^FOUNDATION^bind-predecessor-digest^MIGRATE^verify-predecessor-digest^a version label without its exact predecessor digest is unknown|obligation=governance/migration-receipt^A migration receipt binds the predecessor, successor, changes, and receipt material.^OUTCOME^COHERENCE^accept-migration-receipt^MIGRATE^bind-receipt-to-both-versions^the receipt makes a legal denominator transition replayable|obligation=governance/legacy-summary^An aggregate improvement rate is not an admissible denominator member.^GUARDRAIL^REGRESSION^reject-summary-substitution^GUARD^preserve-exact-members^prose and aggregate summaries cannot authorize a basis change"
activity ProposeDenominatorChange(DenominatorVersion) -> ChangeReason computes "proposals|proposal=proposal-1^gooo/measurement-denominator/v1^sha256:f949ee273d3a6ddca5fb4e0e2b219ce8dfe3eaa43bdf2cd0d2f48020c6e0c319^gooo/measurement-denominator/v2^receipt-legal-advance|proposal=proposal-2^gooo/measurement-denominator/v1^sha256:f949ee273d3a6ddca5fb4e0e2b219ce8dfe3eaa43bdf2cd0d2f48020c6e0c319^gooo/measurement-denominator/v2^none|proposal=proposal-3^gooo/measurement-denominator/v9^sha256:unknown-predecessor^gooo/measurement-denominator/v10^none|addition=governance/replay-receipt^NEW_MEASURABLE_OBLIGATION^The migration receipt replay obligation is recorded as a new measurable member.^OUTCOME^COHERENCE^accept-receipt-replay^MIGRATE^replay-successor-digest^the receipt is replayable evidence|deletion=governance/legacy-summary^DEPRECATED_DUPLICATE"
activity BindPredecessorDigest(DenominatorVersion) -> PredecessorEvidence computes "predecessors|known=gooo/measurement-denominator/v1|unknown=gooo/measurement-denominator/v9|successor=gooo/measurement-denominator/v2|unknown-successor=gooo/measurement-denominator/v10"
activity RecordChangeReasons(ChangeReason) -> MigrationReceipt computes "receipt-material|id=receipt-legal-advance|predecessor=gooo/measurement-denominator/v1^sha256:f949ee273d3a6ddca5fb4e0e2b219ce8dfe3eaa43bdf2cd0d2f48020c6e0c319|successor=gooo/measurement-denominator/v2^sha256:af97536da0d7260f0dacc3f7ab43db1db2cdb3fc6e9e53af479fda2290d12b26|addition=governance/replay-receipt^NEW_MEASURABLE_OBLIGATION|deletion=governance/legacy-summary^DEPRECATED_DUPLICATE"
activity IssueMigrationReceipt(PredecessorEvidence) -> MigrationReceipt computes "receipt-bind|predecessor=gooo/measurement-denominator/v1^sha256:f949ee273d3a6ddca5fb4e0e2b219ce8dfe3eaa43bdf2cd0d2f48020c6e0c319|successor=gooo/measurement-denominator/v2^sha256:af97536da0d7260f0dacc3f7ab43db1db2cdb3fc6e9e53af479fda2290d12b26"
