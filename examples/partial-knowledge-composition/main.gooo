package partialknowledgecomposition
namespace partialknowledgecomposition

entity MetaValue id "gooo://partial-knowledge-composition/entity/meta-value"
entity ObservationReceipt id "gooo://partial-knowledge-composition/entity/observation-receipt"
entity ClaimTransition id "gooo://partial-knowledge-composition/entity/claim-transition"
entity Producer id "gooo://partial-knowledge-composition/entity/producer"
entity Consumer id "gooo://partial-knowledge-composition/entity/consumer"
entity ProofChoice id "gooo://partial-knowledge-composition/entity/proof-choice"
entity ExactKnowledge id "gooo://partial-knowledge-composition/value/exact"
entity DirectUnknown id "gooo://partial-knowledge-composition/value/direct-unknown"
entity DependencyBlocked id "gooo://partial-knowledge-composition/value/dependency-blocked"
entity InvariantOnly id "gooo://partial-knowledge-composition/value/invariant-only"
entity MixedUnresolved id "gooo://partial-knowledge-composition/value/mixed-unresolved"
entity CompositionReceipt id "gooo://partial-knowledge-composition/entity/composition-receipt"
entity Foundation id "gooo://partial-knowledge-composition/proof/foundation"
entity Coherence id "gooo://partial-knowledge-composition/proof/coherence"
entity Regression id "gooo://partial-knowledge-composition/proof/regression"

activity ObserveExactPair(MetaValue) -> ObservationReceipt computes "gooo.partial-knowledge.recipe/v3|case=exact-pair|producer=partial-knowledge-producer|consumer=partial-knowledge-composition-consumer|meta_operation=compose-partial-knowledge|proof_choice=COHERENCE|left.operation=observe-source-shape|left.required=source-shape|left.observation_recipe=exact|left.dependency_recipe=none|left.invariant_capability=none|right.operation=observe-receipt-shape|right.required=receipt-shape|right.observation_recipe=exact|right.dependency_recipe=none|right.invariant_capability=none"
activity ObserveDirectUnknown(MetaValue) -> ObservationReceipt computes "gooo.partial-knowledge.recipe/v3|case=direct-unknown|producer=partial-knowledge-producer|consumer=partial-knowledge-composition-consumer|meta_operation=compose-partial-knowledge|proof_choice=FOUNDATION|left.operation=observe-source-shape|left.required=source-shape|left.observation_recipe=missing|left.dependency_recipe=none|left.invariant_capability=none|right.operation=observe-receipt-shape|right.required=receipt-shape|right.observation_recipe=exact|right.dependency_recipe=none|right.invariant_capability=none"
activity ObserveDependencyBlock(MetaValue) -> ObservationReceipt computes "gooo.partial-knowledge.recipe/v3|case=dependency-blocked|producer=partial-knowledge-producer|consumer=partial-knowledge-composition-consumer|meta_operation=compose-partial-knowledge|proof_choice=COHERENCE|left.operation=observe-source-shape|left.required=source-shape|left.observation_recipe=exact|left.dependency_recipe=none|left.invariant_capability=none|right.operation=bind-receipt-shape|right.required=receipt-shape|right.observation_recipe=dependency|right.dependency_recipe=receipt-shape|right.invariant_capability=none"
activity ObserveInvariant(MetaValue) -> ObservationReceipt computes "gooo.partial-knowledge.recipe/v3|case=invariant-preservation|producer=partial-knowledge-producer|consumer=partial-knowledge-composition-consumer|meta_operation=preserve-known-invariant|proof_choice=FOUNDATION|left.operation=observe-source-shape|left.required=source-shape|left.observation_recipe=exact|left.dependency_recipe=none|left.invariant_capability=none|right.operation=preserve-read-only-boundary|right.required=read-only-boundary|right.observation_recipe=invariant|right.dependency_recipe=none|right.invariant_capability=repository-snapshot-unchanged"
activity ObserveMixedUnresolved(MetaValue) -> ObservationReceipt computes "gooo.partial-knowledge.recipe/v3|case=mixed-unknown-and-blocked|producer=partial-knowledge-producer|consumer=partial-knowledge-composition-consumer|meta_operation=compose-partial-knowledge|proof_choice=REGRESSION|left.operation=observe-source-shape|left.required=source-shape|left.observation_recipe=missing|left.dependency_recipe=none|left.invariant_capability=none|right.operation=bind-receipt-shape|right.required=receipt-shape|right.observation_recipe=dependency|right.dependency_recipe=receipt-shape|right.invariant_capability=none"

activity Compose(MetaValue, MetaValue) -> MetaValue
activity PreserveInvariant(MetaValue) -> InvariantOnly
activity EmitReceipt(CompositionReceipt) -> ClaimTransition
