package selfimprovement
namespace meta

entity SourceTree id "gooo://meta/source-tree"
entity SourceMetrics id "gooo://meta/source-metrics"
entity GenerationPlan id "gooo://meta/generation-plan"
entity ExecutionManifest id "gooo://meta/execution-manifest"
entity Receipt id "gooo://meta/receipt"
entity Evidence id "gooo://meta/evidence"
entity ProofChoice id "gooo://meta/proof-choice"
entity LanguageExperimentReceipt id "gooo://meta/language-experiment-receipt"
entity ReadOnlyImprovementInput id "gooo://meta/read-only-improvement-input"

entity Foundation id "proof://foundation"
entity Coherence id "proof://coherence"
entity Regression id "proof://regression"

entity WorkspaceSourceSplitter id "executor://cmd/gooo:package-split-source"
entity RefactorMetrics id "executor://scripts/refactor-metrics"
entity SourceSplitter id "executor://scripts/source-splitter"
entity FunctionExtractor id "executor://bootstrap/function-extractor"
entity SyntaxRegistrationWorker id "executor://scripts/meta-execution:registration-worker"

activity Measure(SourceTree) -> SourceMetrics id "meta://activity/measure"
activity ChooseProof(Foundation, Coherence, Regression) -> ProofChoice id "meta://activity/choose-proof"
activity Plan(SourceMetrics, ProofChoice) -> GenerationPlan id "meta://activity/plan"
activity Execute(
    GenerationPlan, WorkspaceSourceSplitter, RefactorMetrics,
    SourceSplitter, FunctionExtractor, SyntaxRegistrationWorker
) -> ExecutionManifest id "meta://activity/execute"
activity Evaluate(ExecutionManifest) -> Receipt id "meta://activity/evaluate"
activity Verify(Receipt) -> Evidence id "meta://activity/verify"
activity Observe(LanguageExperimentReceipt) -> ReadOnlyImprovementInput id "meta://activity/observe"
activity Improve(Evidence) -> SourceTree id "meta://activity/improve"
entity SourceExecutionReceipt id "gooo://evidence/source-execution-receipt"
entity IndependentArtifactOracle id "gooo://evidence/independent-artifact-oracle"
entity SourceBindingPromotion id "gooo://claim/source-binding-promotion"
activity PromoteSourceBinding(
    SourceExecutionReceipt, IndependentArtifactOracle
) -> SourceBindingPromotion id "meta://activity/promote-source-binding"
