package metacircularboundary
namespace metacircularboundary

entity MetaOperation id "gooo://meta-circular-boundary/entity/meta-operation"
entity SelfDescription id "gooo://meta-circular-boundary/entity/self-description"
entity ReadOnlyCapability id "gooo://meta-circular-boundary/entity/read-only-capability"
entity ExecutionReceipt id "gooo://meta-circular-boundary/entity/execution-receipt"
entity ForgedCapability id "gooo://meta-circular-boundary/entity/forged-capability"

activity DescribeMetaOperation(MetaOperation) -> SelfDescription
activity GrantReadOnlyMetaCapability(SelfDescription) -> ReadOnlyCapability
activity ExecuteMetaOperation(ReadOnlyCapability) -> ExecutionReceipt
activity InspectForgedCapability(SelfDescription) -> ForgedCapability
activity DescriptionOnlyAttempt(SelfDescription) -> ExecutionReceipt computes "meta-circular-boundary.case|id=description-only|description=source|request=NONE|request_execution=true"
activity ExplicitReadOnlyCapabilityAttempt(SelfDescription) -> ExecutionReceipt computes "meta-circular-boundary.case|id=explicit-read-only-capability|description=source|request=READ_ONLY|request_execution=true"
activity ForgedCapabilityAttempt(SelfDescription) -> ForgedCapability computes "meta-circular-boundary.case|id=forged-capability|description=source|request=READ_ONLY|request_execution=true"
activity WriteCapabilityAttempt(SelfDescription) -> ExecutionReceipt computes "meta-circular-boundary.case|id=write-capability-out-of-scope|description=source|request=READ_ONLY|request_execution=true"
