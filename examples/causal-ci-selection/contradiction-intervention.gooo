package causalselection
namespace causalselection

entity ChangedFile id "gooo://causal-ci-selection/surface/changed-file"
entity CausalClaim id "gooo://causal-ci-selection/claim/causal-selection"
entity PolicySurface id "gooo://causal-ci-selection/surface/semantic-policy"
entity OpenState id "gooo://causal-ci-selection/claim-state/open"
entity DischargedState id "gooo://causal-ci-selection/claim-state/discharged"
entity RefutedState id "gooo://causal-ci-selection/claim-state/refuted"
entity GofmtCheck id "gooo://causal-ci-selection/check/01-gofmt"
entity GoVetCheck id "gooo://causal-ci-selection/check/02-go-vet"
entity GoTestCheck id "gooo://causal-ci-selection/check/03-go-test"
entity GoTestRaceCheck id "gooo://causal-ci-selection/check/04-go-test-race"
entity SemanticCheck id "gooo://causal-ci-selection/check/05-semantic-conformance"
entity CIPolicyCheck id "gooo://causal-ci-selection/check/06-ci-policy"

activity ChangedFileToClaim(ChangedFile) -> CausalClaim computes "causal-ci.changed-file-to-claim/v2"
activity ClaimToSurface(CausalClaim) -> PolicySurface computes "causal-ci.claim-to-surface/v2"
activity SurfaceToGoTest(PolicySurface) -> GoTestCheck computes "causal-ci.surface-to-check/v2"
activity SurfaceToGoVet(PolicySurface) -> GoVetCheck computes "causal-ci.surface-to-check/v2"
activity PriorClaimState(CausalClaim) -> OpenState computes "causal-ci.prior-claim-state/open/v2"
activity DischargeClaim(CausalClaim) -> DischargedState computes "causal-ci.claim-transition/discharged/v2"
activity PreserveClaim(CausalClaim) -> OpenState computes "causal-ci.claim-transition/open-lower-resolution/v2"
activity RefuteClaim(CausalClaim) -> RefutedState computes "causal-ci.claim-transition/refuted/v2"
