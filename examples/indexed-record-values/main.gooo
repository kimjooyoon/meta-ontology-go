package indexorigin
namespace indexorigin
entity Integer id "urn:gooo:type:integer"
entity Item id "urn:index:item" fields {
 field value id "urn:index:value" type integer required one
 field ignored id "urn:index:ignored" type integer required one
}
entity State id "urn:index:state" fields {
 field items id "urn:index:items" type Item required many
 field offset id "urn:index:offset" type integer required one
 field unused id "urn:index:unused" type integer required one
}
activity Read(State) -> Integer id "urn:index:read" computes `
 let items = input.items
 let 커서 = input.offset + 1
 return items[커서].value
`
