package resolutionlattice
namespace meta

entity PartialObservation id "gooo://resolution-lattice/partial-observation"
entity UnknownValue id "gooo://resolution-lattice/unknown-value"
entity ResolutionStage id "gooo://resolution-lattice/resolution-stage"
entity ResolutionStep id "gooo://resolution-lattice/resolution-step"
entity Reason id "gooo://resolution-lattice/reason"
entity Claim id "gooo://resolution-lattice/claim"
entity LatticeTransition id "gooo://resolution-lattice/lattice-transition"
entity LatticeReceipt id "gooo://resolution-lattice/lattice-receipt"
entity IndependentJudge id "gooo://resolution-lattice/independent-judge"
entity Foundation id "proof://foundation"
entity Coherence id "proof://coherence"
entity Regression id "proof://regression"

activity ObservePartialObservation(PartialObservation) -> UnknownValue
activity DescendToInvariantOnly(UnknownValue, ResolutionStage) -> ResolutionStep
activity PreserveClaimState(Claim, ResolutionStep) -> Claim
activity EmitResolutionReceipt(ResolutionStep, Claim) -> LatticeReceipt
activity AdjudicateReceipt(LatticeReceipt, IndependentJudge) -> LatticeReceipt

// The case values are Gooo value programs, not Go fixtures. The producer
// reads every field after resolution-lattice.case; and the independent judge
// reconstructs the same records from these activity declarations.
activity CaseExactObservation(PartialObservation) -> Claim computes "resolution-lattice.case;id=exact-observation;required=3;observed=3;reason=OBSERVATION_COMPLETE;repository_writes=0;mutation_authority=false;claim_id=claim-exact-observation;claim_prior_state=DISCHARGED"
activity CasePartialInvariantDescent(PartialObservation) -> Claim computes "resolution-lattice.case;id=partial-invariant-descent;required=3;observed=2;reason=REQUIRED_INPUT_UNOBSERVED;repository_writes=0;mutation_authority=false;claim_id=claim-invariant-fallback;claim_prior_state=OPEN"
activity CaseMalformedObservation(PartialObservation) -> Claim computes "resolution-lattice.case;id=malformed-observation;required=3;observed=4;reason=OBSERVATION_CARDINALITY_INVALID;repository_writes=0;mutation_authority=false;claim_id=claim-exact-under-missing-evidence;claim_prior_state=OPEN"
activity CaseMutationAuthority(PartialObservation) -> Claim computes "resolution-lattice.case;id=mutation-authority;required=3;observed=2;reason=REQUIRED_INPUT_UNOBSERVED;repository_writes=0;mutation_authority=true;claim_id=claim-write-free-descent;claim_prior_state=DISCHARGED"
