    {"case_id": "missing-regression-witness", "expected_decision": "BLOCKED", "expected_resolution": "LOWER_RESOLUTION", "expected_reason": "REGRESSION_REPLAY_RECIPE_UNAVAILABLE", "expected_status": "OPEN", "expected_effect_count": 0},
    {"case_id": "approved-artifact", "expected_decision": "AUTHORIZED", "expected_resolution": "EXACT", "expected_reason": "ALL_INVARIANTS_DISCHARGED", "expected_status": "DISCHARGED", "expected_effect_count": 1}
