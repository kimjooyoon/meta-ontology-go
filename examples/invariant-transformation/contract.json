    {"id": "postcondition", "kind": "POSTCONDITION", "producer": "invarianttransformation.producer", "consumer": "invarianttransformation.independent-judge", "meta_operation": "compare-postcondition", "proof_choice": "COHERENCE", "verification_check": "compare-lowered-semantic-output-to-invariant", "coordinate": {"stage": "POSTCONDITION", "step": "compare-semantic-value", "reason": "SEMANTIC_POSTCONDITION"}},
