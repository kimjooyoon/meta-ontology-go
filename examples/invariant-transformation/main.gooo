package invarianttransformation
namespace meta

entity SourceSnapshot id "gooo://invariant-transformation/value/source-snapshot"
entity Precondition id "gooo://invariant-transformation/value/precondition"
entity Transformation id "gooo://invariant-transformation/value/transformation"
entity Postcondition id "gooo://invariant-transformation/value/postcondition"
entity RegressionWitness id "gooo://invariant-transformation/value/regression-witness"
entity TransformationReceipt id "gooo://invariant-transformation/value/transformation-receipt"
entity ApprovedArtifactEffect id "gooo://invariant-transformation/value/approved-artifact-effect"
entity TransformationAuthority id "gooo://invariant-transformation/value/transformation-authority"

activity BindTransformationPrecondition(SourceSnapshot) -> Precondition computes "meta.invariant-transformation.precondition:v1"
activity ObserveTransformationResult(Precondition) -> Transformation computes "meta.invariant-transformation.transformation:v1"
activity ComparePostcondition(Transformation) -> Postcondition computes "meta.invariant-transformation.postcondition:v1"
activity ReplayRegressionWitness(Transformation, Postcondition) -> RegressionWitness computes "meta.invariant-transformation.regression:v1"
activity AuthorizeInvariantTransformation(Precondition, Transformation, Postcondition, RegressionWitness) -> TransformationAuthority computes "meta.invariant-transformation.authority:v1"
activity EmitTransformationReceipt(TransformationAuthority) -> TransformationReceipt computes "meta.invariant-transformation.receipt:v1"
activity RecordApprovedArtifactEffect(TransformationAuthority) -> ApprovedArtifactEffect computes "meta.invariant-transformation.effect:v1"
