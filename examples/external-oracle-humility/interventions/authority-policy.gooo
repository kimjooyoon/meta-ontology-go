package externaloraclehumility
namespace externaloraclehumility

entity SemanticSubject id "gooo://external-oracle-humility/entity/semantic-subject"
entity PolicyInput id "gooo://external-oracle-humility/entity/policy-input"
entity PolicyReceipt id "gooo://external-oracle-humility/entity/policy-receipt"
entity SourceClaim id "gooo://external-oracle-humility/entity/source-claim"
entity ComparisonClaim id "gooo://external-oracle-humility/entity/comparison-claim"
entity ReplayClaim id "gooo://external-oracle-humility/entity/replay-claim"
entity SourceReceipt id "gooo://external-oracle-humility/entity/source-receipt"
entity ReferenceAgreement id "gooo://external-oracle-humility/entity/reference-agreement"
entity AuthorityBoundary id "gooo://external-oracle-humility/entity/authority-boundary"
entity ClaimTransition id "gooo://external-oracle-humility/entity/claim-transition"
entity HumilityReceipt id "gooo://external-oracle-humility/entity/humility-receipt"

activity ComputeSourceAuthorityPolicy(PolicyInput) -> PolicyReceipt computes "source_authority=EXTERNAL_REFERENCE_AUTHORITY;external_evidence_relation=COMPARATIVE_EVIDENCE;external_evidence_authority=NOT_AUTHORITY"
activity DeclareSourceIntentAuthority(PolicyReceipt) -> SourceClaim computes "claim_id=source-intent-authority;state=SOURCE_ONLY"
activity DeclareReferenceComparisonOnly(PolicyReceipt) -> ComparisonClaim computes "claim_id=reference-comparison-only;state=EVIDENCE_ONLY"
activity DeclareReceiptReplayability(PolicyReceipt) -> ReplayClaim computes "claim_id=receipt-replayability;state=REPLAYABLE_EVIDENCE"
activity ObserveGoooSource(SemanticSubject) -> SourceReceipt computes "stage=observe;step=source-receipt;reason=SOURCE_POLICY_BOUND"
activity CompareExternalReference(SourceReceipt) -> ReferenceAgreement computes "stage=compare;step=reference-capsule;reason=COMPARISON_ONLY"
activity RefuseExternalSemanticAuthority(ReferenceAgreement) -> AuthorityBoundary computes "stage=govern;step=authority-boundary;reason=NO_EXTERNAL_PROMOTION"
activity PersistClaimTransition(AuthorityBoundary) -> ClaimTransition computes "stage=persist;step=claim-ledger;reason=STATUS_WITH_EVIDENCE_DIGEST"
activity EmitReadOnlyHumilityReceipt(ClaimTransition) -> HumilityReceipt computes "stage=report;step=read-only-snapshot;reason=NO_OFFICIAL_MUTATION"
