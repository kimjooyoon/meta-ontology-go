package fillcalls
namespace fillcalls

entity Integer id "fillcalls://integer"

activity Step(Integer) -> Integer computes "return input * 2"

activity Build(Integer) -> Integer computes "return Step(input + __GOOO_BODY_HOLE_offset__) + __GOOO_BODY_HOLE_bias__" assembling {
  source_fill intent "Add one before doubling the input." {
    hole "offset"
    hole "bias"
    candidate "unchanged" { fill "offset" "0" fill "bias" "0" }
    candidate "shifted" { fill "offset" "1" fill "bias" "0" }
  }
  case "2" -> "6"
  holdout_case "100" -> "202"
}

activity Main(Integer) -> Integer computes "return Build(input)"
