package relation
namespace relation
entity Integer id "relation://integer"
entity Boolean id "relation://boolean"
activity Fee(Integer) -> Integer id "relation://fee" computes "return 11-input" assembling {
 choice "direction" operand_order at "0" intent "Increasing the input should not decrease the fee."
 criteria {
  predicate "decreasing" activity "Decreasing"
  input "[4]"
  input "[5]"
 }
 attempts "2"
}
activity Decreasing(Integer,Integer) -> Boolean computes "return input1 == 11-input0"
activity Nondecreasing(Integer) -> Boolean id "relation://nondecreasing" computes "let first=Fee(input); let second=Fee(input+1); return first <= second"
