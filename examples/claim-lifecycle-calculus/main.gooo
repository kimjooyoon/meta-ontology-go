package claimlifecycle
namespace claimlifecycle

entity Claim id "gooo://claim-lifecycle/claim"
entity Evidence id "gooo://claim-lifecycle/evidence"
entity ClaimCase id "gooo://claim-lifecycle/claim-case"
entity Proposition id "gooo://claim-lifecycle/proposition"
entity Observation id "gooo://claim-lifecycle/observation"
entity LifecycleReceipt id "gooo://claim-lifecycle/lifecycle-receipt"

activity DeclareClaim(Claim) -> ClaimCase computes "claim-case/v1;case_id=declared-open;claim_id=claim:declared-open;claim_subject=sensor;claim_predicate=reports;claim_object=ready;observation_ids=;observation_tuples=;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=observe;provenance=DeclareClaim"
activity ObserveSameTuple(ClaimCase, Proposition, Observation) -> ClaimCase computes "claim-case/v1;case_id=supporting-discharge;claim_id=claim:supporting-discharge;claim_subject=alice;claim_predicate=is;claim_object=awake;observation_ids=evidence:supporting;observation_tuples=alice,is,awake,field-support;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=compare;provenance=ObserveSameTuple"
activity ObserveDifferentObject(ClaimCase, Proposition, Observation) -> ClaimCase computes "claim-case/v1;case_id=contradicting-refutation;claim_id=claim:contradicting-refutation;claim_subject=server;claim_predicate=status;claim_object=healthy;observation_ids=evidence:contradicting;observation_tuples=server,status,down,field-contradiction;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=compare;provenance=ObserveDifferentObject"
activity ObserveInsufficientTuple(ClaimCase, Proposition, Observation) -> ClaimCase computes "claim-case/v1;case_id=direct-unknown;claim_id=claim:direct-unknown;claim_subject=cache;claim_predicate=contains;claim_object=token;observation_ids=evidence:insufficient;observation_tuples=cache,holds,token,field-insufficient;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=compare;provenance=ObserveInsufficientTuple"
activity ResolveDependency(ClaimCase) -> ClaimCase computes "claim-case/v1;case_id=dependent-unknown;claim_id=claim:dependent-unknown;claim_subject=service;claim_predicate=depends_on;claim_object=cache;observation_ids=;observation_tuples=;dependency_claim_id=claim:direct-unknown;observed_stage=RESOLVE;observed_step=dependency;provenance=ResolveDependency"
activity ObserveConflictingTuples(ClaimCase, Proposition, Observation) -> ClaimCase computes "claim-case/v1;case_id=ambiguous-evidence;claim_id=claim:ambiguous-evidence;claim_subject=door;claim_predicate=state;claim_object=open;observation_ids=evidence:ambiguous-open,evidence:ambiguous-closed;observation_tuples=door,state,open,field-a|door,state,closed,field-b;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=compare;provenance=ObserveConflictingTuples"
