package claimlifecycle
namespace claimlifecycle

entity Claim id "gooo://claim-lifecycle/claim"
entity Evidence id "gooo://claim-lifecycle/evidence"
entity OpenClaim id "gooo://claim-lifecycle/open-claim"
entity DischargedClaim id "gooo://claim-lifecycle/discharged-claim"
entity RefutedClaim id "gooo://claim-lifecycle/refuted-claim"
entity LifecycleReceipt id "gooo://claim-lifecycle/lifecycle-receipt"

activity DeclareClaim(Claim) -> OpenClaim computes "claim-case/v1;case_id=declared-open;claim_id=claim:declared-open;prior_state=OPEN;evidence_kind=UNAVAILABLE;evidence_id=;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=observe;observed_reason=EVIDENCE_UNAVAILABLE;expected_status=OPEN;expected_decision=UNKNOWN;provenance=DeclareClaim"
activity AcceptSupportingEvidence(OpenClaim, Evidence) -> DischargedClaim computes "claim-case/v1;case_id=supporting-discharge;claim_id=claim:supporting-discharge;prior_state=OPEN;evidence_kind=SUPPORTING;evidence_id=evidence:supporting;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=classify;observed_reason=SUPPORTING_EVIDENCE;expected_status=DISCHARGED;expected_decision=PASS;provenance=AcceptSupportingEvidence"
activity ApplyContradictingEvidence(OpenClaim, Evidence) -> RefutedClaim computes "claim-case/v1;case_id=contradicting-refutation;claim_id=claim:contradicting-refutation;prior_state=OPEN;evidence_kind=CONTRADICTING;evidence_id=evidence:contradicting;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=classify;observed_reason=CONTRADICTING_EVIDENCE;expected_status=REFUTED;expected_decision=PASS;provenance=ApplyContradictingEvidence"
activity PreserveOpenOnMissingEvidence(OpenClaim) -> OpenClaim computes "claim-case/v1;case_id=direct-unknown;claim_id=claim:direct-unknown;prior_state=OPEN;evidence_kind=UNAVAILABLE;evidence_id=;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=observe;observed_reason=EVIDENCE_UNAVAILABLE;expected_status=OPEN;expected_decision=UNKNOWN;provenance=PreserveOpenOnMissingEvidence"
activity EmitLifecycleReceipt(OpenClaim) -> LifecycleReceipt computes "claim-case/v1;case_id=dependent-unknown;claim_id=claim:dependent-unknown;prior_state=OPEN;evidence_kind=DEPENDENCY_BLOCKED;evidence_id=;dependency_claim_id=claim:direct-unknown;observed_stage=RESOLVE;observed_step=dependency;observed_reason=UPSTREAM_CLAIM_OPEN;expected_status=OPEN;expected_decision=UNKNOWN;provenance=EmitLifecycleReceipt"
activity RejectAmbiguousEvidence(OpenClaim, Evidence) -> OpenClaim computes "claim-case/v1;case_id=ambiguous-evidence;claim_id=claim:ambiguous-evidence;prior_state=OPEN;evidence_kind=AMBIGUOUS;evidence_id=;dependency_claim_id=;observed_stage=EVIDENCE;observed_step=classify;observed_reason=AMBIGUOUS_EVIDENCE;expected_status=OPEN;expected_decision=FAIL_CLOSED;provenance=RejectAmbiguousEvidence"
