package clipartial
namespace clipartial
entity Integer id "urn:clipartial:integer"
entity Boolean id "urn:clipartial:boolean"
activity Deduct(Integer) -> Integer id "urn:clipartial:deduct" computes "return input - 49" assembling {
 choice "direction" operand_order at "0" intent "입력에서 49을 뺀다. Subtract 49 from the input."
 criteria { predicate "difference" activity "CorrectDifference" input "[42]" input "[67]" holdout_input "[93]" }
 attempts "1"
}
activity CorrectDifference(Integer,Integer) -> Boolean computes "return input1 == input0 - 49"
