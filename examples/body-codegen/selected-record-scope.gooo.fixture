    field value id "urn:gooo:record-scope:Unused16:value" type integer required one
}

activity Triple(Request) -> Result id "urn:gooo:record-scope:triple" computes `
let scratch = Scratch{value: input.value * 3}
return Result{value: scratch.value}
`
activity Evaluate(Request) -> Result id "urn:gooo:record-scope:evaluate" computes `
let Unused00 = input.value < 0
let next = Triple(input)
if Unused00 { next.value = 0 }
next.value = next.value + 1
return next
`
