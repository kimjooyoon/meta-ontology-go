package semanticflow
namespace semanticflow
entity Integer id "semanticflow://integer"
activity Choose(Integer) -> Integer computes "let result = input; if input < 11 { result = 11 } else { result = input }; let saved = result; result = 11; return saved" assembling {
 choice "comparison" operand_order at "0" intent "입력이 기준값보다 작은지 판단한다. Compare input with the threshold."
 choice "branches" branch_layout at "0" intent "Choose the greater integer. 더 큰 정수를 고른다."
 case "-9007199254740995" -> "11"
 case "0" -> "11"
 case "10" -> "11"
 case "11" -> "11"
 case "12" -> "12"
 case "9007199254740993" -> "9007199254740993"
 case "9007199254740995" -> "9007199254740995"
 case "18014398509481990" -> "18014398509481990"
 condition_case "comparison" input "-9007199254740995" -> "true"
 condition_case "comparison" input "11" -> "false"
 condition_case "comparison" input "18014398509481990" -> "false"
 attempts "4"
}

activity Main(Integer) -> Integer computes "return Choose(input)"
