package batchamount
namespace batchamount
entity Integer id "batchamount://integer"

activity Choose(Integer) -> Integer computes "let backlog = input; let threshold = 8; let amount = backlog; if backlog < threshold { amount = backlog * 2 } else { amount = backlog + 3 }; return amount" assembling {
    choice "layout" branch_layout at "0" intent "대기 작업이 8개 미만이면 3을 더하고 그 이상이면 두 배를 처리량으로 사용한다. Add three below eight, otherwise double the backlog."
    choice "boundary" operand_order at "0" intent "대기 작업이 8개 미만인지 판단한다. Check whether the backlog is below eight."
    case "0" -> "3"
    case "3" -> "6"
    case "8" -> "16"
    case "13" -> "26"
    condition_case "boundary" input "0" -> "true"
    condition_case "boundary" input "8" -> "false"
    condition_case "boundary" input "13" -> "false"
    attempts "4"
}

activity Main(Integer) -> Integer computes "return Choose(input)"
