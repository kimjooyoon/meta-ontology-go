package recordfill
namespace recordfill

entity Candidate id "recordfill://candidate" fields {
    field candidate_id id "recordfill://candidate/id" type integer required one
    field state id "recordfill://candidate/state" type string required one
}

entity Review id "recordfill://review" fields {
    field candidate_id id "recordfill://review/candidate-id" type integer required one
    field decision id "recordfill://review/decision" type string required one
}

activity ReviewCandidate(Candidate) -> Review computes `if __GOOO_BODY_HOLE_condition__ {
    return Review{candidate_id: input.candidate_id, decision: __GOOO_BODY_HOLE_accepted__}
} else {
    return Review{candidate_id: input.candidate_id, decision: __GOOO_BODY_HOLE_rejected__}
}` assembling {
    source_fill intent "Accept ready candidates and reject candidates in other states using typed record fields." {
        hole "condition"
        hole "accepted"
        hole "rejected"
        candidate "ready_is_accepted" {
            fill "condition" "input.state == \"ready\""
            fill "accepted" "\"accepted\""
            fill "rejected" "\"rejected\""
        }
        candidate "ready_is_rejected" {
            fill "condition" "input.state != \"ready\""
            fill "accepted" "\"accepted\""
            fill "rejected" "\"rejected\""
        }
    }
    value_case "[{\"candidate_id\":1,\"state\":\"ready\"}]" -> "{\"candidate_id\":1,\"decision\":\"accepted\"}"
    value_case "[{\"candidate_id\":2,\"state\":\"queued\"}]" -> "{\"candidate_id\":2,\"decision\":\"rejected\"}"
}
