package callerpaths
namespace callerpaths
entity Integer id "callerpaths://integer"

activity Choose(Integer) -> Integer computes "if input < 0 { return input } else { return 0 - input }" assembling {
    choice "sign" branch_layout at "0" intent "양수 입력은 그대로 반환한다. Return the positive input unchanged."
    choice "comparison" operand_order at "0" intent "음수 입력인지 비교한다. Compare whether input is negative."
    choice "negative" operand_order at "1" intent "음수 값을 구성한다. Construct the negative value."
    case "-9" -> "9"
    case "-2" -> "2"
    case "0" -> "0"
    case "2" -> "2"
    case "9" -> "9"
    case "-9007199254740995" -> "9007199254740995"
    case "9007199254740995" -> "9007199254740995"
    condition_case "comparison" input "-9007199254740995" -> "true"
    condition_case "comparison" input "0" -> "false"
    condition_case "comparison" input "9007199254740995" -> "false"
    attempts "8"
}

activity Main(Integer) -> Integer computes "return Choose(input) + input"
