package fillflow
namespace fillflow
entity Integer id "fillflow://integer"
entity Boolean id "fillflow://boolean"

activity Lift(Integer) -> Integer computes `let base = __GOOO_BODY_HOLE_seed__
let increment = __GOOO_BODY_HOLE_step__
return base + increment` assembling {
    source_fill intent "입력에 1을 더한다. Add one to the input." {
        hole "seed"
        hole "step"
        candidate "add_one" { fill "seed" "input + 0" fill "step" "1" }
        candidate "double" { fill "seed" "input * 2" fill "step" "0" }
        candidate "subtract_one" { fill "seed" "input - 0" fill "step" "-1" }
    }
    case "-2" -> "-1"
    case "0" -> "1"
    case "7" -> "8"
    holdout_case "20" -> "21"
}

activity Scale(Integer) -> Integer computes `let base = __GOOO_BODY_HOLE_seed__
let offset = __GOOO_BODY_HOLE_step__
return base + offset` assembling {
    source_fill intent "입력을 두 배로 만든다. Multiply the input by two." {
        hole "seed"
        hole "step"
        candidate "add_one" { fill "seed" "input + 0" fill "step" "1" }
        candidate "double" { fill "seed" "input * 2" fill "step" "0" }
        candidate "subtract_one" { fill "seed" "input - 0" fill "step" "-1" }
    }
    case "-1" -> "-2"
    case "1" -> "2"
    case "8" -> "16"
    holdout_case "21" -> "42"
}

activity Positive(Integer) -> Boolean computes "return input > 0"
bind Lift.result -> Scale.input
bind Scale.result -> Positive.input
