package recordintegerrange
namespace recordintegerrange

entity Candidate id "recordintegerrange://candidate" fields {
    field score id "recordintegerrange://candidate/score" type integer required one
}

entity Decision id "recordintegerrange://decision" fields {
    field accepted id "recordintegerrange://decision/accepted" type boolean required one
}

activity WithinPreferredRange(Candidate) -> Decision computes `if __GOOO_BODY_HOLE_condition__ {
    return Decision{accepted: true}
} else {
    return Decision{accepted: false}
}` assembling {
    source_fill intent "Accept candidates whose score is inside the preferred interval." {
        hole "condition"
        derive assignments max_candidates "16" {
            hole "condition" grammar "record-field-predicate-composition/v2" max_expressions "16"
        }
    }
    value_case "[{\"score\":0}]" -> "{\"accepted\":false}"
    value_case "[{\"score\":1}]" -> "{\"accepted\":true}"
    value_case "[{\"score\":2}]" -> "{\"accepted\":true}"
    value_case "[{\"score\":3}]" -> "{\"accepted\":false}"
    holdout_value_case "[{\"score\":-1}]" -> "{\"accepted\":false}"
    holdout_value_case "[{\"score\":4}]" -> "{\"accepted\":false}"
}
