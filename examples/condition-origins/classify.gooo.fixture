package originusage
namespace originusage

entity Origin id "originusage://origin" fields {
 field site_id id "originusage://site" type "urn:gooo:type:string" required one
 field selected id "originusage://selected" type "urn:gooo:type:boolean" required one
 field original id "originusage://original" type "urn:gooo:type:boolean" required one
 field declaration id "originusage://declaration" type "urn:gooo:type:boolean" required one
 field ref_count id "originusage://fields" type "urn:gooo:type:integer" required one
 field located_count id "originusage://located" type "urn:gooo:type:integer" required one
}
entity Text id "urn:gooo:type:string"

activity Describe(Origin) -> Text id "originusage://describe" computes "if !input.selected || !input.declaration || input.ref_count != input.located_count { return \"origin-unresolved\" }; if input.original { return \"source-retained\" }; return \"selected-source\""
