entity ClaimBeta id "gooo://nonmonotonic-refutation/claim/beta"
entity ClaimGamma id "gooo://nonmonotonic-refutation/claim/gamma"
entity EqualityPredicate id "gooo://nonmonotonic-refutation/predicate/equality"
