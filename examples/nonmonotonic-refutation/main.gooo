package nonmonotonicrefutation
namespace nonmonotonicrefutation

# The source is the authority for subjects, observations, values, provenance,
# and revision policy. The consumer derives the evidence kind from equality.
entity ClaimAlpha id "gooo://nonmonotonic-refutation/claim/alpha"
entity ClaimBeta id "gooo://nonmonotonic-refutation/claim/beta"
entity ClaimGamma id "gooo://nonmonotonic-refutation/claim/gamma"
entity EqualityPredicate id "gooo://nonmonotonic-refutation/predicate/equality"
entity ExpectedOne id "gooo://nonmonotonic-refutation/value/one"

entity ObservationAlpha1 id "gooo://nonmonotonic-refutation/observation/alpha-1"
entity ObservationBeta1 id "gooo://nonmonotonic-refutation/observation/beta-1"
entity ObservationBeta2 id "gooo://nonmonotonic-refutation/observation/beta-2"
entity ObservationGamma1 id "gooo://nonmonotonic-refutation/observation/gamma-1"
entity ObservationGamma2 id "gooo://nonmonotonic-refutation/observation/gamma-2"
entity ObservationGamma3 id "gooo://nonmonotonic-refutation/observation/gamma-3"

activity ObserveAlpha1(ClaimAlpha, EqualityPredicate, ExpectedOne) -> ObservationAlpha1 computes "meta.observe:v1;claim=alpha;predicate=equality;expected=1;observed=1;provenance=observer-alpha-1;evidence_digest=sha256:7d7141de8d7967ed741d50ff3774faa5e7bd6183afdf63504de77f11c5a2843c;prior=OPEN;revision_policy=NEVER_REOPEN;producer=producer://nonmonotonic-refutation;consumer=consumer://nonmonotonic-refutation-oracle;meta_operation=meta://revise-claim-by-evidence;proof_choice=FOUNDATION;stage=EVIDENCE;step=01"
activity ObserveBeta1(ClaimBeta, EqualityPredicate, ExpectedOne) -> ObservationBeta1 computes "meta.observe:v1;claim=beta;predicate=equality;expected=1;observed=1;provenance=observer-beta-1;evidence_digest=sha256:b187c4d9c2d108075cdb2d7e06ef0b6d3468c85fad33c337e463b4dee60fe10e;prior=OPEN;revision_policy=NEVER_REOPEN;producer=producer://nonmonotonic-refutation;consumer=consumer://nonmonotonic-refutation-oracle;meta_operation=meta://revise-claim-by-evidence;proof_choice=COHERENCE;stage=EVIDENCE;step=01"
activity ObserveBeta2(ClaimBeta, EqualityPredicate, ExpectedOne) -> ObservationBeta2 computes "meta.observe:v1;claim=beta;predicate=equality;expected=1;observed=0;provenance=observer-beta-2;evidence_digest=sha256:1efee6a6963c25101f50eb90f776224ba056a730ee446b79a53240019c1cdbee;prior=DISCHARGED;revision_policy=NEVER_REOPEN;producer=producer://nonmonotonic-refutation;consumer=consumer://nonmonotonic-refutation-oracle;meta_operation=meta://revise-claim-by-evidence;proof_choice=COHERENCE;stage=EVIDENCE;step=02"
activity ObserveGamma1(ClaimGamma, EqualityPredicate, ExpectedOne) -> ObservationGamma1 computes "meta.observe:v1;claim=gamma;predicate=equality;expected=1;observed=1;provenance=observer-gamma-1;evidence_digest=sha256:3060f85f9975ae5a49c30522c5e8fefd010524aef0d38e11e40c8485aa08a9ba;prior=OPEN;revision_policy=REOPEN_IF_NEWER_ADMISSIBLE;producer=producer://nonmonotonic-refutation;consumer=consumer://nonmonotonic-refutation-oracle;meta_operation=meta://revise-claim-by-evidence;proof_choice=REGRESSION;stage=EVIDENCE;step=01"
activity ObserveGamma2(ClaimGamma, EqualityPredicate, ExpectedOne) -> ObservationGamma2 computes "meta.observe:v1;claim=gamma;predicate=equality;expected=1;observed=0;provenance=observer-gamma-2;evidence_digest=sha256:a4a2b1b00c1fb03b89bc0c7197667cca707d8f7cc0f2000ff836edabb672b5cb;prior=DISCHARGED;revision_policy=REOPEN_IF_NEWER_ADMISSIBLE;producer=producer://nonmonotonic-refutation;consumer=consumer://nonmonotonic-refutation-oracle;meta_operation=meta://revise-claim-by-evidence;proof_choice=REGRESSION;stage=EVIDENCE;step=02"
activity ObserveGamma3(ClaimGamma, EqualityPredicate, ExpectedOne) -> ObservationGamma3 computes "meta.observe:v1;claim=gamma;predicate=equality;expected=1;observed=1;provenance=observer-gamma-3;evidence_digest=sha256:15de49dfedb1fca38f661c28831916e1772566083d061d83a99320fdb6163fd3;prior=REFUTED;revision_policy=REOPEN_IF_NEWER_ADMISSIBLE;producer=producer://nonmonotonic-refutation;consumer=consumer://nonmonotonic-refutation-oracle;meta_operation=meta://revise-claim-by-evidence;proof_choice=REGRESSION;stage=REASSESS;step=03"
