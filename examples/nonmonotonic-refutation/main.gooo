activity DeclareRevisionPolicy(RevisionPolicy) -> RevisionPolicyBinding computes "meta.revision-policy:v1;policy_id=gooo://nonmonotonic-refutation/policy/nonmonotonic-v4;correction_relation=SUPERSEDES;correction_target=EVIDENCE_DIGEST;unknown_action=RETAIN_CURRENT;insufficient_action=RETAIN_CURRENT;ordinary_support_after_refuted=RETAIN_REFUTED;foundation_rule=FIRST_CLAIM_OBSERVATION;coherence_rule=LATER_OBSERVATION_AFTER_FIRST_SOURCE_EVENT;regression_rule=SEQUENCE_AT_LEAST_5_WITH_PRIOR_CLAIM;fixture_class=HISTORICAL_FIXTURE;policy_digest=sha256:6bd0416e2017ffd4ab27f38a441bdc1abb9d2ede4a74bd8b2d799a9dcd77ed86"

activity ObserveAlpha1(ClaimAlpha, EqualityPredicate, SubjectAlpha, InputAlpha, ExpectedOne) -> ObservationAlpha1 computes "meta.observe:v3;claim=alpha;proposition=equals:alpha:input-alpha:1;subject=alpha;input=input-alpha;predicate=equality;expected=1;observed=1;observed_material=fixture:alpha:input-alpha:value-1;observation_quality=SUFFICIENT;provider_class=HISTORICAL_FIXTURE;provenance=fixture-provider-alpha-1;revision_relation=NONE;supersedes_evidence_digest=none;policy_id=gooo://nonmonotonic-refutation/policy/nonmonotonic-v4;policy_digest=sha256:6bd0416e2017ffd4ab27f38a441bdc1abb9d2ede4a74bd8b2d799a9dcd77ed86;producer=producer://nonmonotonic-refutation;consumer=consumer://nonmonotonic-refutation-oracle;meta_operation=meta://revise-claim-by-evidence;proof_choice=FOUNDATION;stage=EVIDENCE;step=01"
