package proofartifact
namespace proofartifact

entity SourceEvidence id "gooo://proof/source-evidence"
entity OperationEvidence id "gooo://proof/operation-evidence"
entity InvariantEvidence id "gooo://proof/invariant-evidence"
entity ProofCarryingArtifact id "gooo://proof/proof-carrying-artifact"
entity SourceBytes id "gooo://proof/source-bytes"
entity OperationReceipt id "gooo://proof/operation-receipt"
entity InvariantObservation id "gooo://proof/invariant-observation"
entity RecipeProjection id "gooo://proof/recipe-projection"
entity EvidenceRole id "gooo://proof/evidence-role"
entity VerificationStep id "gooo://proof/verification-step"
entity ProofChoice id "gooo://proof/proof-choice"
entity DependencyEdge id "gooo://proof/dependency-edge"
entity ReadOnlyConsumption id "gooo://proof/read-only-consumption"
entity CaseEnvelopeIssue id "gooo://proof/case-envelope-issue"
entity CaseEnvelopePolicy id "gooo://proof/case-envelope-policy"

activity GenerateProofCarryingArtifact(SourceEvidence, OperationEvidence, InvariantEvidence) -> ProofCarryingArtifact
activity DeclareSourceEvidenceRole(SourceBytes) -> EvidenceRole computes "proof.recipe.role;claim=source-bytes-bound;proposition=source-bytes-match;target=raw-source-digest;proof=FOUNDATION;step=verify-source;operation=bind-source-bytes"
activity DeclareOperationEvidenceRole(OperationReceipt) -> EvidenceRole computes "proof.recipe.role;claim=operation-receipt-bound;proposition=operation-receipt-match;target=operation-receipt-digest;proof=COHERENCE;step=verify-operation;operation=bind-operation-receipt;requires=source-bytes-bound"
activity DeclareInvariantEvidenceRole(InvariantObservation) -> EvidenceRole computes "proof.recipe.role;claim=no-byte-authority;proposition=generated-bytes-do-not-grant-authority;target=read-only-capability-boundary;proof=REGRESSION;step=verify-invariant;operation=preserve-no-byte-authority"
activity DeclareRecipeRole(RecipeProjection) -> EvidenceRole computes "proof.recipe.role;claim=recipe-match;proposition=consumer-recipe-matches-source-recipe;target=recipe-digest;proof=COHERENCE;step=verify-recipe;operation=match-independent-recipe;requires=source-bytes-bound,operation-receipt-bound,no-byte-authority"
activity DeclareConsumerAuthorityRole(ReadOnlyConsumption) -> EvidenceRole computes "proof.recipe.role;claim=consumer-authority;proposition=verified-consumer-may-read-only-consume;target=READ_ONLY_CONSUMPTION;proof=COHERENCE;step=grant-read-only-consumption;operation=grant-read-only-consumption;requires=source-bytes-bound,operation-receipt-bound,no-byte-authority,recipe-match"
activity DeclareVerificationStep(EvidenceRole) -> VerificationStep computes "proof.recipe.meta;version=2;id=gooo://recipe/language-proof-carrying-artifact/v2;consumer=gooo://consumer/language-proof-carrying-artifact-verifier;entry=GenerateProofCarryingArtifact;authority=READ_ONLY_CONSUMPTION;requires=source-bytes-bound,operation-receipt-bound,no-byte-authority,recipe-match;mutation=false;promotion=false;semantic=false"
activity LinkSourceToOperation(SourceEvidence, OperationEvidence) -> DependencyEdge computes "proof.recipe.dependency;from=source-bytes-bound;to=operation-receipt-bound;relation=requires"
activity LinkOperationToInvariant(OperationEvidence, InvariantEvidence) -> DependencyEdge computes "proof.recipe.dependency;from=operation-receipt-bound;to=no-byte-authority;relation=requires"
activity LinkEvidenceToRecipe(SourceEvidence, OperationEvidence) -> DependencyEdge computes "proof.recipe.dependency;from=source-bytes-bound,operation-receipt-bound,no-byte-authority;to=recipe-match;relation=requires"
activity LinkRecipeToConsumer(RecipeProjection, ReadOnlyConsumption) -> DependencyEdge computes "proof.recipe.dependency;from=source-bytes-bound,operation-receipt-bound,no-byte-authority,recipe-match;to=consumer-authority;relation=requires"
activity DeclareExternalEvidenceAbsentPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=EXTERNAL_EVIDENCE_ABSENT;rank=1"
activity DeclareOperationEvidenceMissingPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=OPERATION_EVIDENCE_MISSING;rank=2"
activity DeclareOperationAttachmentMissingPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=OPERATION_ATTACHMENT_MISSING;rank=3"
activity DeclareEvidenceDigestMismatchPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=EVIDENCE_DIGEST_MISMATCH;rank=4"
activity DeclareLedgerMismatchPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=LEDGER_MISMATCH;rank=5"
activity DeclareClaimStructureMismatchPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=CLAIM_STRUCTURE_MISMATCH;rank=6"
activity DeclareSourceReconstructionMismatchPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=SOURCE_RECONSTRUCTION_MISMATCH;rank=7"
activity DeclareOperationAttachmentDigestMismatchPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=OPERATION_ATTACHMENT_DIGEST_MISMATCH;rank=8"
activity DeclareOperationReconstructionMismatchPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=OPERATION_RECONSTRUCTION_MISMATCH;rank=9"
activity DeclareInvariantEvidenceNotPreservedPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=INVARIANT_EVIDENCE_NOT_PRESERVED;rank=10"
activity DeclareRecipeMismatchPriority(CaseEnvelopeIssue) -> CaseEnvelopePolicy computes "proof.case-envelope.issue;kind=RECIPE_MISMATCH;rank=11"
activity SelectCaseEnvelopeIssue(CaseEnvelopePolicy) -> CaseEnvelopePolicy computes "proof.case-envelope.reduction;operation=SELECT_LOWEST_DECLARED_RANK;missing=FAIL_CLOSED;duplicate=FAIL_CLOSED;unknown=FAIL_CLOSED"
