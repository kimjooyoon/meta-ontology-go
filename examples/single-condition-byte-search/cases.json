        }
      },
      "expected": {
        "gooo/examples/bytefill:IndexByte": {
          "offset": 0
        }
      }
    },
    {
      "inputs": {
        "gooo/examples/bytefill:IndexByte": {
          "needle": 122,
          "text": ""
        }
      },
      "expected": {
        "gooo/examples/bytefill:IndexByte": {
          "offset": 1023
        }
      }
    },
    {
      "inputs": {
        "gooo/examples/bytefill:IndexByte": {
          "needle": 120,
          "text": "가x"
        }
      },
      "expected": {
        "gooo/examples/bytefill:IndexByte": {
          "offset": 3
        }
      }
    }
