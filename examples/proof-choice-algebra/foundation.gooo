package proofchoice
namespace proofchoice
// nonsemantic-marker: foundation
entity ClaimValue id "gooo://proof-choice/foundation/claim-value"
entity MetricValue id "gooo://proof-choice/foundation/metric-value"
activity FoundationClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.foundation\",\"statement\":\"stable identity anchors the claim\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/foundation/subject\",\"evidence_capabilities\":[\"FOUNDATION\"]}"
activity FoundationMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"metric\",\"id\":\"metric.foundation.coverage\",\"statement\":\"stable identity anchors the claim\",\"subject\":\"gooo://proof-choice/foundation/subject\",\"evidence_capabilities\":[\"FOUNDATION\"]}"
