package proofchoice
namespace proofchoice
entity ClaimValue id "gooo://proof-choice/unknown/claim-value"
entity MetricValue id "gooo://proof-choice/unknown/metric-value"
activity UnknownClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.unknown\",\"statement\":\"the missing capability cannot resolve this claim\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/unknown/subject\"}"
activity UnknownMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"metric\",\"id\":\"metric.unknown.coverage\",\"statement\":\"the missing capability cannot resolve this claim\",\"subject\":\"gooo://proof-choice/unknown/subject\"}"
