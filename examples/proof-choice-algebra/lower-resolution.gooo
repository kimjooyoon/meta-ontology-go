package proofchoice
namespace proofchoice
entity Observation id "gooo://proof-choice/lower/observation"
entity ClaimValue id "gooo://proof-choice/lower/claim-value"
entity MetricValue id "gooo://proof-choice/lower/metric-value"
activity ObserveUnstableAnchor() -> Observation computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"observation\",\"id\":\"obs.lower.anchor\",\"evidence_kind\":\"FOUNDATION\",\"predicate\":\"identity\",\"value\":\"unstable\",\"observed\":true,\"provenance\":[\"source://lower/anchor\"]}"
activity LowerClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"claim\",\"id\":\"claim.lower\",\"statement\":\"an unstable anchor is insufficient\",\"prior_state\":\"OPEN\",\"dependencies\":[\"obs.lower.anchor\"],\"observations\":[\"obs.lower.anchor\"],\"admissible_routes\":[\"FOUNDATION\"]}"
activity LowerMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"metric\",\"id\":\"metric.lower.coverage\",\"observations\":[\"obs.lower.anchor\"],\"admissible_routes\":[\"FOUNDATION\"],\"slots\":[{\"id\":\"lower-slot-1\",\"observed\":true,\"provenance\":[\"slot://lower/1\"]},{\"id\":\"lower-slot-2\",\"observed\":true,\"provenance\":[\"slot://lower/2\"]},{\"id\":\"lower-slot-3\",\"observed\":true,\"provenance\":[\"slot://lower/3\"]}]}"
