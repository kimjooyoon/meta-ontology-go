package proofchoice
namespace proofchoice
entity ClaimValue id "gooo://proof-choice/lower/claim-value"
entity MetricValue id "gooo://proof-choice/lower/metric-value"
activity LowerClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.lower\",\"statement\":\"an unstable anchor is insufficient\",\"prior_state\":\"OPEN\",\"subject\":\"unstable://proof-choice/lower/subject\",\"evidence_capabilities\":[\"FOUNDATION\"]}"
activity LowerMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"metric\",\"id\":\"metric.lower.coverage\",\"statement\":\"an unstable anchor is insufficient\",\"subject\":\"unstable://proof-choice/lower/subject\",\"evidence_capabilities\":[\"FOUNDATION\"]}"
