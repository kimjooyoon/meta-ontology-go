package proofchoice
namespace proofchoice
entity Observation id "gooo://proof-choice/coherence/observation"
entity ClaimValue id "gooo://proof-choice/coherence/claim-value"
entity MetricValue id "gooo://proof-choice/coherence/metric-value"
activity ObserveRelations() -> Observation computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"observation\",\"id\":\"obs.coherence.neighbors\",\"evidence_kind\":\"COHERENCE\",\"predicate\":\"relations\",\"value\":\"agree\",\"observed\":true,\"provenance\":[\"relation://coherence/neighbors\"]}"
activity CoherenceClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"claim\",\"id\":\"claim.coherence\",\"statement\":\"neighboring claims agree\",\"prior_state\":\"OPEN\",\"dependencies\":[\"obs.coherence.neighbors\"],\"observations\":[\"obs.coherence.neighbors\"],\"admissible_routes\":[\"COHERENCE\"]}"
activity CoherenceMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"metric\",\"id\":\"metric.coherence.coverage\",\"observations\":[\"obs.coherence.neighbors\"],\"admissible_routes\":[\"COHERENCE\"],\"slots\":[{\"id\":\"coherence-slot-1\",\"observed\":true,\"provenance\":[\"slot://coherence/1\"]},{\"id\":\"coherence-slot-2\",\"observed\":true,\"provenance\":[\"slot://coherence/2\"]},{\"id\":\"coherence-slot-3\",\"observed\":true,\"provenance\":[\"slot://coherence/3\"]}]}"
