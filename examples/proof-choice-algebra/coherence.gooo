package proofchoice
namespace proofchoice
entity ClaimValue id "gooo://proof-choice/coherence/claim-value"
entity MetricValue id "gooo://proof-choice/coherence/metric-value"
activity CoherenceClaimA() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.coherence.a\",\"statement\":\"neighboring claims agree\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/coherence/subject\",\"evidence_capabilities\":[\"COHERENCE\"]}"
activity CoherenceClaimB() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.coherence.b\",\"statement\":\"neighboring claims agree\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/coherence/subject\",\"evidence_capabilities\":[\"COHERENCE\"]}"
activity CoherenceMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"metric\",\"id\":\"metric.coherence.coverage\",\"statement\":\"neighboring claims agree\",\"subject\":\"gooo://proof-choice/coherence/subject\",\"evidence_capabilities\":[\"COHERENCE\"]}"
