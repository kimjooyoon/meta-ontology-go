package proofchoice
namespace proofchoice

// proof-choice {"kind":"claim","id":"claim.unknown-context","choice":"FOUNDATION","statement":"a claim with an undisclosed evaluation context","producer":"source-author","consumer":"proof-ledger","meta_operation":"bind-foundation","stage":"UNKNOWN","step":"UNKNOWN","reason":"UNKNOWN"}
// proof-choice {"kind":"metric","id":"metric.unknown-context","choice":"FOUNDATION","statement":"an unknown context cannot certify the metric","producer":"metric-producer","consumer":"proof-ledger","meta_operation":"measure-foundation","stage":"UNKNOWN","step":"UNKNOWN","reason":"UNKNOWN","numerator":3,"denominator":3}
// proof-choice {"kind":"transition","claim_id":"claim.unknown-context","from":"ASSERTED","to":"PERSISTED","choice":"FOUNDATION","producer":"claim-ledger","consumer":"proof-ledger","meta_operation":"persist-claim","stage":"UNKNOWN","step":"UNKNOWN","reason":"UNKNOWN","persistent":true}

entity UnknownContextSource id "gooo://proof-choice/unknown/source"
entity UnknownContextClaim id "gooo://proof-choice/unknown/claim"
entity UnknownContextMetric id "gooo://proof-choice/unknown/metric"

activity BindUnknown(UnknownContextSource) -> UnknownContextClaim
activity MeasureUnknown(UnknownContextClaim) -> UnknownContextMetric
