package proofchoice
namespace proofchoice
entity ClaimValue id "gooo://proof-choice/combined/claim-value"
entity MetricValue id "gooo://proof-choice/combined/metric-value"
entity CompositionValue id "gooo://proof-choice/combined/composition-value"
activity FoundationClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.combined.foundation\",\"statement\":\"the bundle has a stable anchor\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/combined/foundation\",\"evidence_capabilities\":[\"FOUNDATION\"]}"
activity CoherenceClaimA() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.combined.coherence.a\",\"statement\":\"the bundle closes its relation\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/combined/coherence\",\"evidence_capabilities\":[\"COHERENCE\"]}"
activity CoherenceClaimB() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.combined.coherence.b\",\"statement\":\"the bundle closes its relation\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/combined/coherence\",\"evidence_capabilities\":[\"COHERENCE\"]}"
activity RegressionClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.combined.regression\",\"statement\":\"the bundle replays exactly\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/combined/regression\",\"evidence_capabilities\":[\"REGRESSION\"]}"
activity CombinedComposition() -> CompositionValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"composition\",\"id\":\"z.composition.combined\",\"statement\":\"all three independent proof routes compose\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/combined/result\",\"members\":[\"claim.combined.foundation\",\"claim.combined.coherence.a\",\"claim.combined.regression\"]}"
activity CombinedMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"metric\",\"id\":\"metric.combined.coverage\",\"statement\":\"the bundle closes its relation\",\"subject\":\"gooo://proof-choice/combined/coherence\",\"evidence_capabilities\":[\"COHERENCE\"]}"
