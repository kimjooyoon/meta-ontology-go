package proofchoice
namespace proofchoice
entity Observation id "gooo://proof-choice/contradiction/observation"
entity ClaimValue id "gooo://proof-choice/contradiction/claim-value"
entity MetricValue id "gooo://proof-choice/contradiction/metric-value"
activity ObserveAnchor() -> Observation computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"observation\",\"id\":\"obs.contradiction.anchor\",\"evidence_kind\":\"FOUNDATION\",\"predicate\":\"identity\",\"value\":\"stable\",\"observed\":true,\"provenance\":[\"source://contradiction/anchor\"]}"
activity ObserveRelations() -> Observation computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"observation\",\"id\":\"obs.contradiction.relations\",\"evidence_kind\":\"COHERENCE\",\"predicate\":\"relations\",\"value\":\"agree\",\"observed\":true,\"provenance\":[\"relation://contradiction/neighbors\"]}"
activity ContradictoryClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"claim\",\"id\":\"claim.contradiction\",\"statement\":\"two routes are simultaneously evidenced\",\"prior_state\":\"OPEN\",\"dependencies\":[\"obs.contradiction.anchor\",\"obs.contradiction.relations\"],\"observations\":[\"obs.contradiction.anchor\",\"obs.contradiction.relations\"],\"admissible_routes\":[\"FOUNDATION\",\"COHERENCE\"]}"
activity ContradictoryMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"metric\",\"id\":\"metric.contradiction.coverage\",\"observations\":[\"obs.contradiction.anchor\",\"obs.contradiction.relations\"],\"admissible_routes\":[\"FOUNDATION\",\"COHERENCE\"],\"slots\":[{\"id\":\"contradiction-slot-1\",\"observed\":true,\"provenance\":[\"slot://contradiction/1\"]},{\"id\":\"contradiction-slot-2\",\"observed\":true,\"provenance\":[\"slot://contradiction/2\"]},{\"id\":\"contradiction-slot-3\",\"observed\":true,\"provenance\":[\"slot://contradiction/3\"]}]}"
