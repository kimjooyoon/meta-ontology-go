package proofchoice
namespace proofchoice
entity ClaimValue id "gooo://proof-choice/contradiction/claim-value"
activity ContradictoryClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.contradiction\",\"statement\":\"two independent routes are evidenced\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/contradiction/subject\",\"evidence_capabilities\":[\"FOUNDATION\",\"COHERENCE\"]}"
activity ContradictoryPeer() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.contradiction.peer\",\"statement\":\"two independent routes are evidenced\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/contradiction/subject\",\"evidence_capabilities\":[\"COHERENCE\"]}"
