package proofchoice
namespace proofchoice
entity ClaimValue id "gooo://proof-choice/regression/claim-value"
entity MetricValue id "gooo://proof-choice/regression/metric-value"
activity RegressionClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"claim\",\"id\":\"claim.regression\",\"statement\":\"the canonical artifact replays exactly\",\"prior_state\":\"OPEN\",\"subject\":\"gooo://proof-choice/regression/subject\",\"evidence_capabilities\":[\"REGRESSION\"]}"
activity RegressionMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v3\",\"kind\":\"metric\",\"id\":\"metric.regression.coverage\",\"statement\":\"the canonical artifact replays exactly\",\"subject\":\"gooo://proof-choice/regression/subject\",\"evidence_capabilities\":[\"REGRESSION\"]}"
