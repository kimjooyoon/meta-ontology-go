package proofchoice
namespace proofchoice
entity Observation id "gooo://proof-choice/regression/observation"
entity ClaimValue id "gooo://proof-choice/regression/claim-value"
entity MetricValue id "gooo://proof-choice/regression/metric-value"
activity ObserveReplay() -> Observation computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"observation\",\"id\":\"obs.regression.replay\",\"evidence_kind\":\"REGRESSION\",\"predicate\":\"replay\",\"value\":\"equal\",\"observed\":true,\"provenance\":[\"replay://regression/prior-receipt\"]}"
activity RegressionClaim() -> ClaimValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"claim\",\"id\":\"claim.regression\",\"statement\":\"the prior receipt equals the replay\",\"prior_state\":\"OPEN\",\"dependencies\":[\"obs.regression.replay\"],\"observations\":[\"obs.regression.replay\"],\"admissible_routes\":[\"REGRESSION\"]}"
activity RegressionMetric() -> MetricValue computes "{\"schema\":\"gooo/proof-choice-input/v2\",\"kind\":\"metric\",\"id\":\"metric.regression.coverage\",\"observations\":[\"obs.regression.replay\"],\"admissible_routes\":[\"REGRESSION\"],\"slots\":[{\"id\":\"regression-slot-1\",\"observed\":true,\"provenance\":[\"slot://regression/1\"]},{\"id\":\"regression-slot-2\",\"observed\":true,\"provenance\":[\"slot://regression/2\"]},{\"id\":\"regression-slot-3\",\"observed\":true,\"provenance\":[\"slot://regression/3\"]}]}"
