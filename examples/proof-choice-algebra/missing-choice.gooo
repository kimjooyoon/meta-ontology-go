package proofchoice
namespace proofchoice

// proof-choice {"kind":"claim","id":"claim.missing-choice","statement":"this claim omits the epistemic route","producer":"source-author","consumer":"proof-ledger","meta_operation":"bind-claim","stage":"UNKNOWN","step":"UNKNOWN","reason":"UNKNOWN"}
// proof-choice {"kind":"metric","id":"metric.missing-choice","choice":"COHERENCE","statement":"this metric cannot repair a missing claim choice","producer":"metric-producer","consumer":"proof-ledger","meta_operation":"measure-coherence","stage":"relate","step":"coverage","reason":"fixed-denominator","numerator":3,"denominator":3}
// proof-choice {"kind":"transition","claim_id":"claim.missing-choice","from":"ASSERTED","to":"PERSISTED","choice":"COHERENCE","producer":"claim-ledger","consumer":"proof-ledger","meta_operation":"persist-claim","stage":"UNKNOWN","step":"UNKNOWN","reason":"UNKNOWN","persistent":true}

entity MissingChoiceSource id "gooo://proof-choice/missing/source"
entity MissingChoiceClaim id "gooo://proof-choice/missing/claim"
entity MissingChoiceMetric id "gooo://proof-choice/missing/metric"

activity BindMissing(MissingChoiceSource) -> MissingChoiceClaim
activity MeasureMissing(MissingChoiceClaim) -> MissingChoiceMetric
