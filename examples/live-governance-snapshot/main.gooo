package livegovernancesnapshot
namespace livegovernancesnapshot

entity ObservationSourceInput id "gooo://live-governance-snapshot/input/observation-source"
entity ObservationSourceOutput id "gooo://live-governance-snapshot/output/observation-source"
entity ContractManifestInput id "gooo://live-governance-snapshot/input/contract-manifest"
entity ContractManifestOutput id "gooo://live-governance-snapshot/output/contract-manifest"
entity DevBranchInput id "gooo://live-governance-snapshot/input/dev-branch"
entity DevBranchOutput id "gooo://live-governance-snapshot/output/dev-branch"
entity MainBranchInput id "gooo://live-governance-snapshot/input/main-branch"
entity MainBranchOutput id "gooo://live-governance-snapshot/output/main-branch"
entity DevStatusInput id "gooo://live-governance-snapshot/input/dev-status"
entity DevStatusOutput id "gooo://live-governance-snapshot/output/dev-status"
entity DevContextsInput id "gooo://live-governance-snapshot/input/dev-contexts"
entity DevContextsOutput id "gooo://live-governance-snapshot/output/dev-contexts"
entity MainStatusInput id "gooo://live-governance-snapshot/input/main-status"
entity MainStatusOutput id "gooo://live-governance-snapshot/output/main-status"
entity MainContextsInput id "gooo://live-governance-snapshot/input/main-contexts"
entity MainContextsOutput id "gooo://live-governance-snapshot/output/main-contexts"
entity RulesetsInput id "gooo://live-governance-snapshot/input/rulesets"
entity RulesetsOutput id "gooo://live-governance-snapshot/output/rulesets"
entity RulesetAuthorityInput id "gooo://live-governance-snapshot/input/ruleset-authority"
entity RulesetAuthorityOutput id "gooo://live-governance-snapshot/output/ruleset-authority"
entity UnknownCausalityInput id "gooo://live-governance-snapshot/input/unknown-causality"
entity UnknownCausalityOutput id "gooo://live-governance-snapshot/output/unknown-causality"
entity HumanReportInput id "gooo://live-governance-snapshot/input/human-report"
entity HumanReportOutput id "gooo://live-governance-snapshot/output/human-report"

activity PinGovernanceObservationSource(ObservationSourceInput) -> ObservationSourceOutput computes "governance.observation.source/v1"
activity PinGovernanceContractManifest(ContractManifestInput) -> ContractManifestOutput computes "governance.contract.manifest/v1"
activity ObserveDevBranchProtection(DevBranchInput) -> DevBranchOutput computes "governance.dev.branch/v1"
activity ObserveMainBranchProtection(MainBranchInput) -> MainBranchOutput computes "governance.main.branch/v1"
activity CompareDevStatusEnforcement(DevStatusInput) -> DevStatusOutput computes "governance.dev.status/v1"
activity CompareDevRequiredContexts(DevContextsInput) -> DevContextsOutput computes "governance.dev.contexts/v1"
activity CompareMainStatusEnforcement(MainStatusInput) -> MainStatusOutput computes "governance.main.status/v1"
activity CompareMainRequiredContexts(MainContextsInput) -> MainContextsOutput computes "governance.main.contexts/v1"
activity ObserveRepositoryRulesets(RulesetsInput) -> RulesetsOutput computes "governance.rulesets/v1"
activity RejectDisabledRulesetAuthority(RulesetAuthorityInput) -> RulesetAuthorityOutput computes "governance.ruleset.authority/v1"
activity PreserveGovernanceUnknownCausality(UnknownCausalityInput) -> UnknownCausalityOutput computes "governance.unknown.causality/v1"
activity PublishGovernanceDriftReport(HumanReportInput) -> HumanReportOutput computes "governance.drift.report/v1"
