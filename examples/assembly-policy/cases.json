{
  "schema": "gooo/body-composition-cases/v1",
  "cases": [
    {
      "inputs": {
        "Diagnose.input0": 17,
        "Diagnose.input1": 21,
        "Diagnose.input2": 1,
        "Diagnose.input3": "네 필드가 남았습니다"
      },
      "expected": {
        "Diagnose": {
          "code": "partial",
          "message": "네 필드가 남았습니다",
          "action": "repair-and-replay"
