package construction
namespace construction
entity Integer id "construction://integer"

activity Normalize(Integer) -> Integer computes `let output = input
if input < 0 { output = __GOOO_BODY_HOLE_floor__ }
return output` assembling {
    search hole "floor" grammar "integer-offset-constant/v1" intent "Return zero for negative input and preserve other integers." max_candidates "16"
    case "-2" -> "0"
    case "-1" -> "0"
    case "0" -> "0"
    case "1" -> "1"
    case "2" -> "2"
    holdout_case "-100" -> "0"
    attempts "8"
}

activity Lift(Integer) -> Integer computes `let base = __GOOO_BODY_HOLE_seed__
let increment = __GOOO_BODY_HOLE_step__
return base + increment` assembling {
    source_fill intent "Add one to the normalized value." {
        hole "seed"
        hole "step"
        candidate "double" { fill "seed" "input * 2" fill "step" "0" }
        candidate "add_one" { fill "seed" "input" fill "step" "1" }
        candidate "subtract_one" { fill "seed" "input" fill "step" "-1" }
    }
    case "-2" -> "-1"
    case "0" -> "1"
    case "7" -> "8"
    holdout_case "100" -> "101"
}

bind Normalize.result -> Lift.input
