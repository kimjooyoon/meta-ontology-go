package compilerselfimprovement
namespace compiler

entity SourceProgram id "gooo://compiler-self-improvement/entity/source-program"
entity SemanticGraph id "gooo://compiler-self-improvement/entity/semantic-graph"
entity GeneratedCandidate id "gooo://compiler-self-improvement/entity/generated-candidate"
entity ExactObservation id "gooo://compiler-self-improvement/entity/exact-observation"
entity Decision id "gooo://compiler-self-improvement/entity/decision"

activity ObserveSource(SourceProgram) -> SemanticGraph computes "gooo.semantic.graph:v1"
activity GenerateCandidate(SemanticGraph) -> GeneratedCandidate computes "generator.normalizeIR:fold-copy-and-canonicalize/v1;target=internal/generator/normalize_part01.go;fixture=examples/billing/main.gooo"
activity ExecuteBaseline(SourceProgram) -> ExactObservation computes "compiler.measure:baseline:v1"
activity ExecuteCandidate(GeneratedCandidate) -> ExactObservation computes "compiler.measure:candidate:v1"
activity GuardSemantics(ExactObservation) -> Decision computes "compiler.guard:behavior-determinism-memory-time:v1"
activity Decide(Decision) -> Decision computes "compiler.decision:REFUTED>UNKNOWN>CLOSED:v1"
