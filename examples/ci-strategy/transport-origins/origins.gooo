package transportorigins
namespace transportorigins
import cistrategy "examples/cistrategy"
import outcome "examples/transportoutcome"
import rdf "origin/recordeduse"

entity OriginView id "gooo://transport-origins/view" fields {
    field status id "gooo://transport-origins/view/status" type string required one
    field reason id "gooo://transport-origins/view/reason" type string required one
    field report_sha256 id "gooo://transport-origins/view/report" type string required one
    field lines id "gooo://transport-origins/view/lines" type string required many
}
entity WriteRecord id "gooo://transport-origins/write-record" fields {
    field attempted id "gooo://transport-origins/write-record/attempted" type boolean required one
    field status id "gooo://transport-origins/write-record/status" type integer required one
    field error id "gooo://transport-origins/write-record/error" type string required one
}
entity SavedFrame id "gooo://transport-origins/saved-frame" fields {
    field report_sha256 id "gooo://transport-origins/saved-frame/report" type string required one
    field report_bytes id "gooo://transport-origins/saved-frame/bytes" type integer required one
    field fields_complete id "gooo://transport-origins/saved-frame/complete" type boolean required one
    field after_present id "gooo://transport-origins/saved-frame/after" type boolean required one
    field next_present id "gooo://transport-origins/saved-frame/next" type boolean required one
    field decision_generation_sha256 id "gooo://transport-origins/saved-frame/decision-generation" type string required one
    field outcome_generation_sha256 id "gooo://transport-origins/saved-frame/outcome-generation" type string required one
    field projection_generation_sha256 id "gooo://transport-origins/saved-frame/projection-generation" type string required one
}

activity ReportByteLimit() -> rdf.Integer id "gooo://transport-origins/report-byte-limit" computes `
return 262144
`

# A historical content view: source checks compare this report's own observations.
# Reading the view does not dispatch a request or allocate an execution identity.
activity ProjectReport(scope cistrategy.TransportScope, before cistrategy.TransportObservation,
    decision cistrategy.TransportStep, write WriteRecord, after cistrategy.TransportObservation,
    next cistrategy.TransportStep, claim outcome.Outcome, frame SavedFrame, byte_limit rdf.Integer) -> OriginView
id "gooo://transport-origins/project-report" computes `
let view = OriginView{status:"UNRESOLVED_ORIGINS",reason:"REPORT_BYTES_OUTSIDE_PROFILE",
    report_sha256:frame.report_sha256,lines:[]string{}}
if frame.report_bytes < 1 || frame.report_bytes > byte_limit || !rdf.IsSHA256(frame.report_sha256) { return view }
view.reason = "PROJECTION_CONTEXT_REQUIRED"
if !rdf.IsSHA256(frame.projection_generation_sha256) { return view }
view.reason = "READBACK_PAIR_REQUIRED"
if frame.after_present != frame.next_present { return view }
view.reason = "REPORT_FIELDS_MISSING"
if !frame.fields_complete { return view }
view.reason = "SCOPE_DEFINITION_CONFLICT"
if scope != cistrategy.TransportPlan(scope.operation) { return view }
view.reason = "DECISION_SOURCE_CONFLICT"
if decision != cistrategy.TransportNext(scope,before) { return view }
view.reason = "READBACK_SOURCE_CONFLICT"
if frame.after_present && next != cistrategy.TransportNext(scope,after) { return view }
let observation = outcome.Observation{
    effect_id:scope.effect_id,decision_effect_id:decision.effect_id,
    decision_state:decision.state,decision_next:decision.next_operation,
    write_attempted:write.attempted,response_status:write.status,response_error:write.error,
    readback_recorded:frame.after_present,readback_effect_id:"",readback_state:""}
if frame.after_present {
    observation.readback_effect_id = next.effect_id
    observation.readback_state = next.state
}
let assessed = outcome.Assess(observation)
view.reason = "RETAINED_ASSESSMENT_CONFLICT"
if claim != assessed || assessed.state == "INCONSISTENT_OBSERVATION" { return view }
view.reason = "IDENTITY_PROFILE_UNSUPPORTED"
let goal = IRITerm(scope.goal_id)
let plan = IRITerm(scope.plan_id)
let prior = IRITerm(scope.prior_plan_id)
let effect = IRITerm(scope.effect_id)
if goal == "" || plan == "" || prior == "" || effect == "" { return view }
let base = "<urn:gooo:transport-report:" + frame.report_sha256
let report = base + ">"
let general_view = base + ":view>"
let projection = base + ":view:" + frame.projection_generation_sha256 + ">"
let projection_context = "<urn:gooo:projection-generation-context:" + frame.projection_generation_sha256 + ">"
let selected = base + ":decision-record>"
let response = base + ":write-record>"
let readback = base + ":after-record>"
let classified = base + ":next-record>"
let assessment = base + ":outcome-record>"
let proposal = base + ":next-proposal>"
let kind = " <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> "
let prov = " <http://www.w3.org/ns/prov#"
let own = " <gooo://transport-origins/"
let entity = "<http://www.w3.org/ns/prov#Entity> ."
let attempted = "false"
if write.attempted { attempted = "true" }
let has_decision_context = rdf.IsSHA256(frame.decision_generation_sha256)
let has_outcome_context = rdf.IsSHA256(frame.outcome_generation_sha256)
let decision_context = "<urn:gooo:generation-context:" + frame.decision_generation_sha256 + ">"
let outcome_context = "<urn:gooo:generation-context:" + frame.outcome_generation_sha256 + ">"
view.lines = filter_values([]string{
    report + kind + entity,
    general_view + kind + entity,
    projection + kind + entity,
    projection + prov + "specializationOf> " + general_view + " .",
    projection_context + kind + entity,
    projection + own + "projectionGenerationContext> " + projection_context + " .",
    projection + kind + "<gooo://transport-origins/TransportReportProjection> .",
    projection + prov + "wasDerivedFrom> " + report + " .",
    projection + own + "executionIdentity> \"UNOBSERVED\" .",
    goal + kind + entity,
    plan + kind + "<http://www.w3.org/ns/prov#Plan> .",
    prior + kind + "<http://www.w3.org/ns/prov#Plan> .",
    plan + own + "goal> " + goal + " .",
    plan + own + "priorPlan> " + prior + " .",
    selected + kind + entity,
    selected + own + "recordedIn> " + report + " .",
    selected + own + "recordPath> \"/decision\" .",
    selected + own + "sourceActivity> <gooo://ci-strategy/transport-next> .",
    selected + own + "targetEffect> " + effect + " .",
    selected + own + "plan> " + plan + " .",
    response + kind + entity,
    response + own + "recordedIn> " + report + " .",
    response + own + "recordPath> \"/write\" .",
    response + own + "reportedAttempted> \"" + attempted + "\"^^<http://www.w3.org/2001/XMLSchema#boolean> .",
    assessment + kind + entity,
    assessment + own + "recordedIn> " + report + " .",
    assessment + own + "recordPath> \"/outcome\" .",
    assessment + own + "sourceActivity> <gooo://transport-outcome/assess> .",
    assessment + prov + "wasDerivedFrom> " + selected + " .",
    assessment + prov + "wasDerivedFrom> " + response + " .",
    assessment + own + "state> " + rdf.RDFLiteral(assessed.state) + " .",
    proposal + kind + "<http://www.w3.org/ns/prov#Plan> .",
    proposal + own + "recordedIn> " + report + " .",
    proposal + own + "recordPath> \"/outcome/next_operation\" .",
    proposal + prov + "wasDerivedFrom> " + plan + " .",
    proposal + prov + "wasDerivedFrom> " + assessment + " .",
    proposal + own + "status> \"PROPOSED\" .",
    proposal + own + "operation> " + rdf.RDFLiteral(assessed.next_operation) + " .",
    When(frame.after_present,readback + kind + entity),
    When(frame.after_present,readback + own + "recordedIn> " + report + " ."),
    When(frame.after_present,readback + own + "recordPath> \"/after\" ."),
    When(frame.after_present,classified + kind + entity),
    When(frame.after_present,classified + own + "recordedIn> " + report + " ."),
    When(frame.after_present,classified + own + "recordPath> \"/next\" ."),
    When(frame.after_present,classified + own + "sourceActivity> <gooo://ci-strategy/transport-next> ."),
    When(frame.after_present,classified + prov + "wasDerivedFrom> " + readback + " ."),
    When(frame.after_present,assessment + prov + "wasDerivedFrom> " + classified + " ."),
    When(has_decision_context,decision_context + kind + entity),
    When(has_decision_context,decision_context + own + "recordedIn> " + report + " ."),
    When(has_decision_context,decision_context + own + "recordPath> \"/generation_origin\" ."),
    When(has_decision_context,selected + own + "reportedGenerationContext> " + decision_context + " ."),
    When(has_outcome_context,outcome_context + kind + entity),
    When(has_outcome_context,outcome_context + own + "recordedIn> " + report + " ."),
    When(has_outcome_context,outcome_context + own + "recordPath> \"/outcome_generation_origin\" ."),
    When(has_outcome_context,assessment + own + "reportedGenerationContext> " + outcome_context + " ."),
},NonEmpty)
view.status = "RECORDED_REPORT_ORIGINS"
view.reason = "SAVED_REPORT_CONTENTS"
return view
`

# Bounded ASCII IRIREFs for this example's identifier schemes.
activity IRITerm(rdf.Text) -> rdf.Text id "gooo://transport-origins/iri-term" computes `
if len(input) < 4 || len(input) > 512 { return "" }
let scheme = input[:4] == "urn:"
if len(input) >= 7 && input[:7] == "gooo://" { scheme = true }
if len(input) >= 8 && input[:8] == "https://" { scheme = true }
if !scheme { return "" }
for let index = 0; index < 512; index = index + 1 {
    if index >= int64(len(input)) { return "<" + input + ">" }
    let code = int64(input[index])
    if code <= 32 || code >= 127 || code == 34 || code == 60 || code == 62 ||
       code == 92 || code == 94 || code == 96 || code == 123 || code == 124 || code == 125 { return "" }
}
return "<" + input + ">"
`

activity When(enabled rdf.Boolean, text rdf.Text) -> rdf.Text id "gooo://transport-origins/when" computes `
if enabled { return text }
return ""
`
activity NonEmpty(rdf.Text) -> rdf.Boolean id "gooo://transport-origins/non-empty" computes `
return input != ""
`

bind ReportByteLimit.result -> ProjectReport.input8
