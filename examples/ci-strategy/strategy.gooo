package cistrategy
namespace cistrategy

// The source owns the selection rule. Run IDs, timings and candidate values
// are supplied observations or proposals, not facts inferred by the compiler.
entity StrategyRequest id "gooo://ci-strategy/request" fields {
    field goal_id id "gooo://ci-strategy/request/goal-id" type string required one
    field baseline_run id "gooo://ci-strategy/request/baseline-run" type string required one
    field baseline_ms id "gooo://ci-strategy/request/baseline-ms" type integer required one
    field minimum_gain_ms id "gooo://ci-strategy/request/minimum-gain-ms" type integer required one
    field required_checks_sha256 id "gooo://ci-strategy/request/checks-sha256" type string required one
    field plan_ids id "gooo://ci-strategy/request/plan-ids" type string required many
    field assumption_ids id "gooo://ci-strategy/request/assumption-ids" type string required many
    field expected_ms id "gooo://ci-strategy/request/expected-ms" type integer required many
    field checks_sha256 id "gooo://ci-strategy/request/plan-checks-sha256" type string required many
    field scope_closed id "gooo://ci-strategy/request/scope-closed" type boolean required many
}

entity PlanChoice id "gooo://ci-strategy/choice" fields {
    field goal_id id "gooo://ci-strategy/choice/goal-id" type string required one
    field selected_plan_id id "gooo://ci-strategy/choice/selected-plan-id" type string required one
    field state id "gooo://ci-strategy/choice/state" type string required one
    field expected_gain_ms id "gooo://ci-strategy/choice/expected-gain-ms" type integer required one
    field option_count id "gooo://ci-strategy/choice/option-count" type integer required one
    field eligible_count id "gooo://ci-strategy/choice/eligible-count" type integer required one
    field execution_authorized id "gooo://ci-strategy/choice/execution-authorized" type boolean required one
}

activity SelectPlan(StrategyRequest) -> PlanChoice id "gooo://ci-strategy/select" computes `
let selected = ""
let state = "REJECTED_LOW_VALUE_OR_OPEN_SCOPE"
let gain = 0
let eligible = 0
let invalid = false
let count = int64(len(input.plan_ids))
if input.goal_id == "" || input.baseline_run == "" || input.required_checks_sha256 == "" ||
   input.baseline_ms <= 0 || input.minimum_gain_ms < 0 ||
   count < 2 || count > 32 || len(input.assumption_ids) != count ||
   len(input.expected_ms) != count || len(input.checks_sha256) != count ||
   len(input.scope_closed) != count {
    invalid = true
} else {
    let index = 0
    for plan_id in input.plan_ids {
        if plan_id == "" || input.assumption_ids[index] == "" ||
           input.expected_ms[index] <= 0 || input.checks_sha256[index] == "" {
            invalid = true
        }
        let prior = 0
        for prior_id in input.plan_ids {
            if prior < index && prior_id == plan_id { invalid = true }
            prior = prior + 1
        }
        let candidate_gain = input.baseline_ms - input.expected_ms[index]
        if input.scope_closed[index] && input.checks_sha256[index] == input.required_checks_sha256 &&
           candidate_gain >= input.minimum_gain_ms && candidate_gain > 0 {
            eligible = eligible + 1
            if selected == "" || candidate_gain > gain {
                selected = plan_id
                gain = candidate_gain
            }
        }
        index = index + 1
    }
}
if invalid {
    selected = ""
    gain = 0
    eligible = 0
    state = "INVALID_PROPOSAL"
} else if selected != "" {
    state = "PROPOSED_FOR_EXPERIMENT"
}
return PlanChoice{
    goal_id: input.goal_id,
    selected_plan_id: selected,
    state: state,
    expected_gain_ms: gain,
    option_count: count,
    eligible_count: eligible,
    execution_authorized: false,
}
`

entity OutcomeRequest id "gooo://ci-strategy/outcome-request" fields {
    field revision_id id "gooo://ci-strategy/outcome-request/revision-id" type string required one
    field goal_id id "gooo://ci-strategy/outcome-request/goal-id" type string required one
    field selected_plan_id id "gooo://ci-strategy/outcome-request/selected-plan-id" type string required one
    field baseline_run id "gooo://ci-strategy/outcome-request/baseline-run" type string required one
    field observed_run id "gooo://ci-strategy/outcome-request/observed-run" type string required one
    field baseline_ms id "gooo://ci-strategy/outcome-request/baseline-ms" type integer required one
    field observed_ms id "gooo://ci-strategy/outcome-request/observed-ms" type integer required one
    field minimum_gain_ms id "gooo://ci-strategy/outcome-request/minimum-gain-ms" type integer required one
    field same_workload id "gooo://ci-strategy/outcome-request/same-workload" type boolean required one
    field same_toolchain id "gooo://ci-strategy/outcome-request/same-toolchain" type boolean required one
    field same_runner_class id "gooo://ci-strategy/outcome-request/same-runner-class" type boolean required one
    field required_checks_passed id "gooo://ci-strategy/outcome-request/checks-passed" type boolean required one
}

entity PlanRevision id "gooo://ci-strategy/revision" fields {
    field revision_id id "gooo://ci-strategy/revision/id" type string required one
    field goal_id id "gooo://ci-strategy/revision/goal-id" type string required one
    field prior_plan_id id "gooo://ci-strategy/revision/prior-plan-id" type string required one
    field observed_run id "gooo://ci-strategy/revision/observed-run" type string required one
    field state id "gooo://ci-strategy/revision/state" type string required one
    field observed_gain_ms id "gooo://ci-strategy/revision/observed-gain-ms" type integer required one
    field causal_improvement_claim id "gooo://ci-strategy/revision/causal-claim" type boolean required one
}

activity AssessOutcome(OutcomeRequest) -> PlanRevision id "gooo://ci-strategy/assess" computes `
let state = "INSUFFICIENT_EVIDENCE"
let gain = 0
if input.revision_id != "" && input.goal_id != "" && input.selected_plan_id != "" &&
   input.baseline_run != "" && input.observed_run != "" &&
   input.observed_run != input.baseline_run &&
   input.baseline_ms > 0 && input.observed_ms > 0 && input.minimum_gain_ms >= 0 &&
   input.same_workload && input.same_toolchain &&
   input.same_runner_class && input.required_checks_passed {
    gain = input.baseline_ms - input.observed_ms
    if gain >= input.minimum_gain_ms && gain > 0 {
        state = "OBSERVED_GAIN"
    } else {
        state = "NO_MEANINGFUL_GAIN"
    }
}
return PlanRevision{
    revision_id: input.revision_id,
    goal_id: input.goal_id,
    prior_plan_id: input.selected_plan_id,
    observed_run: input.observed_run,
    state: state,
    observed_gain_ms: gain,
    causal_improvement_claim: false,
}
`

// Recovery is a new plan version. Completed effects remain observations of the
// prior plan; a proposed recovery may not ask to produce the same effect again.
entity RecoveryRequest id "gooo://ci-strategy/recovery-request" fields {
    field revision_id id "gooo://ci-strategy/recovery-request/revision-id" type string required one
    field goal_id id "gooo://ci-strategy/recovery-request/goal-id" type string required one
    field prior_plan_id id "gooo://ci-strategy/recovery-request/prior-plan-id" type string required one
    field recovery_plan_id id "gooo://ci-strategy/recovery-request/recovery-plan-id" type string required one
    field failed_activity_id id "gooo://ci-strategy/recovery-request/failed-activity-id" type string required one
    field failure_observation_id id "gooo://ci-strategy/recovery-request/failure" type string required one
    field completed_effect_ids id "gooo://ci-strategy/recovery-request/completed-effects" type string required many
    field recovery_effect_ids id "gooo://ci-strategy/recovery-request/recovery-effects" type string required many
    field failure_observed id "gooo://ci-strategy/recovery-request/failure-observed" type boolean required one
    field completed_effects_observed id "gooo://ci-strategy/recovery-request/effects-observed" type boolean required one
    field scope_closed id "gooo://ci-strategy/recovery-request/scope-closed" type boolean required one
}

entity RecoveryRevision id "gooo://ci-strategy/recovery-revision" fields {
    field revision_id id "gooo://ci-strategy/recovery-revision/revision-id" type string required one
    field goal_id id "gooo://ci-strategy/recovery-revision/goal-id" type string required one
    field prior_plan_id id "gooo://ci-strategy/recovery-revision/prior-plan-id" type string required one
    field recovery_plan_id id "gooo://ci-strategy/recovery-revision/recovery-plan-id" type string required one
    field failed_activity_id id "gooo://ci-strategy/recovery-revision/failed-activity-id" type string required one
    field failure_observation_id id "gooo://ci-strategy/recovery-revision/failure" type string required one
    field completed_effect_ids id "gooo://ci-strategy/recovery-revision/completed-effects" type string required many
    field recovery_effect_ids id "gooo://ci-strategy/recovery-revision/recovery-effects" type string required many
    field state id "gooo://ci-strategy/recovery-revision/state" type string required one
    field overlap_count id "gooo://ci-strategy/recovery-revision/overlap-count" type integer required one
    field execution_authorized id "gooo://ci-strategy/recovery-revision/execution-authorized" type boolean required one
}

activity ProposeRecovery(RecoveryRequest) -> RecoveryRevision id "gooo://ci-strategy/propose-recovery" computes `
let invalid = false
let overlap = 0
let state = "INSUFFICIENT_EVIDENCE"
let completed_count = int64(len(input.completed_effect_ids))
let recovery_count = int64(len(input.recovery_effect_ids))
if input.revision_id == "" || input.goal_id == "" || input.prior_plan_id == "" ||
   input.recovery_plan_id == "" || input.prior_plan_id == input.recovery_plan_id ||
   input.failed_activity_id == "" || input.failure_observation_id == "" ||
   completed_count < 1 || completed_count > 32 || recovery_count < 1 || recovery_count > 32 {
    invalid = true
}
let completed_index = 0
for completed in input.completed_effect_ids {
    if completed == "" { invalid = true }
    let prior = 0
    for earlier in input.completed_effect_ids {
        if prior < completed_index && earlier == completed { invalid = true }
        prior = prior + 1
    }
    completed_index = completed_index + 1
}
let recovery_index = 0
for proposed in input.recovery_effect_ids {
    if proposed == "" { invalid = true }
    let prior = 0
    for earlier in input.recovery_effect_ids {
        if prior < recovery_index && earlier == proposed { invalid = true }
        prior = prior + 1
    }
    for completed in input.completed_effect_ids {
        if proposed == completed { overlap = overlap + 1 }
    }
    recovery_index = recovery_index + 1
}
if invalid {
    state = "INVALID_PROPOSAL"
} else if overlap > 0 {
    state = "REJECTED_REPLAY"
} else if input.failure_observed && input.completed_effects_observed && input.scope_closed {
    state = "PROPOSED_RECOVERY"
}
return RecoveryRevision{
    revision_id: input.revision_id,
    goal_id: input.goal_id,
    prior_plan_id: input.prior_plan_id,
    recovery_plan_id: input.recovery_plan_id,
    failed_activity_id: input.failed_activity_id,
    failure_observation_id: input.failure_observation_id,
    completed_effect_ids: input.completed_effect_ids,
    recovery_effect_ids: input.recovery_effect_ids,
    state: state,
    overlap_count: overlap,
    execution_authorized: false,
}
`
