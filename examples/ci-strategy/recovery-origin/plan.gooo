package cistrategy
namespace cistrategy

// Source-owned scope for this retained history. Goal and revision IDs are
// retrospective annotations; observations keep their original run references.
activity HistoricalScope(operation OriginText) -> RecoveryScope
id "gooo://ci-strategy/historical-scope" computes `
let plan = ""
let display = ""
if operation == "transport-original-build-proof" {
    plan = "urn:gooo:oci-history:plan:transport-original-proof"
    display = "Keep the image; transport its original build provenance"
} else if operation == "publish-image" {
    plan = "urn:gooo:oci-history:plan:republish"
    display = "Republish the same retained image"
}
return RecoveryScope{
    revision_id: "urn:gooo:oci-history:revision:proof-only",
    goal_id: "urn:gooo:oci-history:goal:public-digest-and-origin",
    prior_plan_id: "https://github.com/kimjooyoon/gooo-go-ports/blob/6ff4e3a6c3baf9b518838bd35d2429decdf991bf/.github/workflows/service-grant-mcp-oci.yml",
    recovery_plan_id: plan,
    failed_activity_id: "https://github.com/kimjooyoon/gooo-go-ports/actions/runs/39672180710/job/119472846036#step:6:1",
    repository: "kimjooyoon/gooo-go-ports",
    source: "6ff4e3a6c3baf9b518838bd35d2429decdf991bf",
    workflow_path: ".github/workflows/service-grant-mcp-oci.yml",
    workflow_sha256: "2c5d256d09f7e9fe708f4a809af772f418f59c54ca42d64b9c93d88ab6df4d5a",
    publish_run: 39672180710,
    publish_attempt: 1,
    publish_job: 119472846036,
    publish_artifact_name: "gooo-oci-publication-39672180710-1",
    publish_step: 5,
    failed_step: 6,
    readback_run: 39673212888,
    readback_attempt: 1,
    readback_job: 119476221244,
    readback_artifact_name: "gooo-oci-anonymous-readback-39673212888-1",
    readback_step: 7,
    observed_at: 1792616400,
    subject: "ghcr.io/kimjooyoon/gooo-service-grant-mcp@sha256:a83d8fa57657bb877453cce7ed11f1ff1000a84b1e80c65a4e1c0b20196d3ee4",
    proposed_subject: "ghcr.io/kimjooyoon/gooo-service-grant-mcp@sha256:a83d8fa57657bb877453cce7ed11f1ff1000a84b1e80c65a4e1c0b20196d3ee4",
    proposed_operation: operation,
    proposed_display_name: display,
}
`

bind HistoricalScope.result -> BindRecovery.input0
