package semanticdeltareceipt
namespace semanticdeltareceipt

entity TextualDelta id "gooo://semantic-delta/entity/textual-delta"
entity StructuralDelta id "gooo://semantic-delta/entity/structural-delta"
entity SemanticClaimDelta id "gooo://semantic-delta/entity/semantic-claim-delta"
entity DeltaReceipt id "gooo://semantic-delta/entity/delta-receipt"
entity IndependentVerdict id "gooo://semantic-delta/entity/independent-verdict"
entity SourcePair id "gooo://semantic-delta/entity/source-pair"
entity SemanticComponentSet id "gooo://semantic-delta/entity/semantic-component-set"
entity TransitionLedger id "gooo://semantic-delta/entity/transition-ledger"
entity DenominatorContract id "gooo://semantic-delta/entity/denominator-contract"

entity NodeSemanticComponent id "gooo://semantic-delta/component/node-semantic"
entity EntityFieldComponent id "gooo://semantic-delta/component/entity-field"
entity ActivityValueProgramComponent id "gooo://semantic-delta/component/activity-value-program"
entity RelationFactComponent id "gooo://semantic-delta/component/relation-fact"
entity IRSemanticFingerprintComponent id "gooo://semantic-delta/component/ir-semantic-fingerprint"

entity BoundedSemanticEquivalence id "gooo://semantic-delta/claim/bounded-equivalence"
entity ObjectProposition id "gooo://semantic-delta/claim/object-proposition"
entity BeforeClaimPreservation id "gooo://semantic-delta/claim/before-claim-preservation"

activity SeparateDeltaLayers(SourcePair) -> DeltaReceipt computes "meta.semantic-delta.layers:textual,structural,semantic"
activity ProjectSemanticComponents(SourcePair) -> SemanticComponentSet computes "meta.semantic-delta.components:node-semantic,entity-field,activity-value-program,relation-fact,ir-semantic-fingerprint"
activity AdjudicateDelta(DeltaReceipt) -> IndependentVerdict computes "meta.semantic-delta.policy:raw-separate;semantic-separate;fail-closed-lower-resolution"
activity RecordTransitionLedger(DeltaReceipt) -> TransitionLedger computes "meta.semantic-delta.ledger:open,discharged,refuted,append-only"
activity DeclareClaimIdentityContract(SourcePair) -> SemanticClaimDelta computes "meta.semantic-delta.claim-identity:v3:object=proposition-kind|canonical-semantic-fact-target-address|stable-relation-role;evidence=source-path|raw-digest|semantic-digest;preservation=before-proposition-id|canonical-pair-target-address|stable-relation-role;inventory=set-canonical"
activity DeclareTransitionIdentityContract(DeltaReceipt) -> TransitionLedger computes "meta.semantic-delta.transition-identity:v2:claim-id|from|to|stage|step|reason|target-semantic-digest;sort-by-claim-id"
activity ValidateFixedDenominator(SourcePair) -> DenominatorContract computes "meta.semantic-delta.denominator:v2:5"
activity DeclareEquivalentCase(SourcePair) -> DenominatorContract computes "meta.semantic-delta.case:equivalent|before:examples/semantic-delta-receipt/before.gooo|after:examples/semantic-delta-receipt/equivalent-after.gooo"
activity DeclareSemanticChangeCase(SourcePair) -> DenominatorContract computes "meta.semantic-delta.case:semantic-change|before:examples/semantic-delta-receipt/before.gooo|after:examples/semantic-delta-receipt/semantic-after.gooo"
activity DeclareValueProgramCase(SourcePair) -> DenominatorContract computes "meta.semantic-delta.case:value-program-change|before:examples/semantic-delta-receipt/value-program-before.gooo|after:examples/semantic-delta-receipt/value-program-after.gooo"
activity DeclareUnsupportedCase(SourcePair) -> DenominatorContract computes "meta.semantic-delta.case:indeterminate|before:examples/semantic-delta-receipt/before.gooo|after:examples/semantic-delta-receipt/indeterminate-after.gooo"
activity DeclareAmbiguousCase(SourcePair) -> DenominatorContract computes "meta.semantic-delta.case:ambiguous-match|before:examples/semantic-delta-receipt/ambiguous-before.gooo|after:examples/semantic-delta-receipt/ambiguous-after.gooo"
activity FixtureCommentOnly(SourcePair) -> SemanticClaimDelta computes "meta.semantic-delta.fixture:comment-only|before:examples/semantic-delta-receipt/comment-only-before.gooo|after:examples/semantic-delta-receipt/comment-only-after.gooo"
activity FixtureFormattingOnly(SourcePair) -> SemanticClaimDelta computes "meta.semantic-delta.fixture:formatting-only|before:examples/semantic-delta-receipt/formatting-before.gooo|after:examples/semantic-delta-receipt/formatting-after.gooo"
activity FixtureSemanticTargetChange(SourcePair) -> SemanticClaimDelta computes "meta.semantic-delta.fixture:semantic-target-change|before:examples/semantic-delta-receipt/before.gooo|after:examples/semantic-delta-receipt/semantic-after.gooo"
activity FixtureClaimRemoval(SourcePair) -> SemanticClaimDelta computes "meta.semantic-delta.fixture:claim-removal|before:examples/semantic-delta-receipt/claim-removal-before.gooo|after:examples/semantic-delta-receipt/claim-removal-after.gooo"
activity FixtureClaimAddition(SourcePair) -> SemanticClaimDelta computes "meta.semantic-delta.fixture:claim-addition|before:examples/semantic-delta-receipt/claim-addition-before.gooo|after:examples/semantic-delta-receipt/claim-addition-after.gooo"
activity FixtureDuplicateStableID(SourcePair) -> SemanticClaimDelta computes "meta.semantic-delta.fixture:duplicate-stable-id|before:examples/semantic-delta-receipt/duplicate-stable-id-before.gooo|after:examples/semantic-delta-receipt/duplicate-stable-id-after.gooo"
