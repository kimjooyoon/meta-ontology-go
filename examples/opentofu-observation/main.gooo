package opentofuobservation
namespace opentofuobservation

entity ReleasePinInput id "gooo://opentofu-observation/input/release-pin"
entity ReleasePinOutput id "gooo://opentofu-observation/output/release-pin"
entity AssetChecksumInput id "gooo://opentofu-observation/input/asset-checksum"
entity AssetChecksumOutput id "gooo://opentofu-observation/output/asset-checksum"
entity VersionJSONInput id "gooo://opentofu-observation/input/version-json"
entity VersionJSONOutput id "gooo://opentofu-observation/output/version-json"
entity FixtureInput id "gooo://opentofu-observation/input/fixture"
entity FixtureOutput id "gooo://opentofu-observation/output/fixture"
entity PlanSchemaInput id "gooo://opentofu-observation/input/plan-schema"
entity PlanSchemaOutput id "gooo://opentofu-observation/output/plan-schema"
entity TestEventsInput id "gooo://opentofu-observation/input/test-events"
entity TestEventsOutput id "gooo://opentofu-observation/output/test-events"
entity RuntimeInput id "gooo://opentofu-observation/input/runtime"
entity RuntimeOutput id "gooo://opentofu-observation/output/runtime"
entity RSSInput id "gooo://opentofu-observation/input/rss"
entity RSSOutput id "gooo://opentofu-observation/output/rss"
entity PlanReplayInput id "gooo://opentofu-observation/input/plan-replay"
entity PlanReplayOutput id "gooo://opentofu-observation/output/plan-replay"
entity TestReplayInput id "gooo://opentofu-observation/input/test-replay"
entity TestReplayOutput id "gooo://opentofu-observation/output/test-replay"
entity ReuseInput id "gooo://opentofu-observation/input/reuse"
entity ReuseOutput id "gooo://opentofu-observation/output/reuse"
entity HumanReportInput id "gooo://opentofu-observation/input/human-report"
entity HumanReportOutput id "gooo://opentofu-observation/output/human-report"

activity PinOpenTofuRelease(ReleasePinInput) -> ReleasePinOutput computes "opentofu.release.pin/v1"
activity VerifyOpenTofuAssetChecksum(AssetChecksumInput) -> AssetChecksumOutput computes "opentofu.asset.checksum/v1"
activity ObserveOpenTofuVersionJSON(VersionJSONInput) -> VersionJSONOutput computes "opentofu.version.json/v1"
activity PinOpenTofuFixtureInput(FixtureInput) -> FixtureOutput computes "opentofu.fixture.input/v1"
activity ValidateOpenTofuPlanJSON(PlanSchemaInput) -> PlanSchemaOutput computes "opentofu.plan.json.schema/v1"
activity AccountOpenTofuTestEvents(TestEventsInput) -> TestEventsOutput computes "opentofu.test.events/v1"
activity RecordOpenTofuCommandRuntime(RuntimeInput) -> RuntimeOutput computes "opentofu.command.runtime/v1"
activity ObserveOpenTofuPeakRSS(RSSInput) -> RSSOutput computes "opentofu.peak.rss/v1"
activity ReplayOpenTofuPlanJSON(PlanReplayInput) -> PlanReplayOutput computes "opentofu.plan.replay/v1"
activity ReplayOpenTofuTestEvents(TestReplayInput) -> TestReplayOutput computes "opentofu.test.replay/v1"
activity EvaluateOpenTofuTestReuse(ReuseInput) -> ReuseOutput computes "opentofu.test.reuse/v1"
activity PublishOpenTofuObservationReport(HumanReportInput) -> HumanReportOutput computes "opentofu.report.publish/v1"
