package repositoryprojectionrepair
namespace meta

entity SourceTree id "repair://source-tree"
entity DensityPlan id "repair://density-plan"
entity ASTRecipe id "repair://ast-recipe"
entity ASTEvidence id "repair://ast-evidence"
entity HelperSet id "repair://helper-set"
entity RewrittenTree id "repair://rewritten-tree"
entity IdentityEvidence id "repair://identity-evidence"
entity WriteSetEvidence id "repair://write-set-evidence"
entity CompiledTree id "repair://compiled-tree"
entity TestEvidence id "repair://test-evidence"
entity ReplayTree id "repair://replay-tree"
entity ReplayEvidence id "repair://replay-evidence"
entity RepairReceipt id "repair://repair-receipt"

activity ObserveDensityPlan(SourceTree) -> DensityPlan computes "proof=FOUNDATION;indicator=DRIVER"
activity DeriveASTRecipe(DensityPlan) -> ASTRecipe computes "proof=FOUNDATION;indicator=OUTCOME"
activity ValidateASTImports(ASTRecipe) -> ASTEvidence computes "proof=FOUNDATION;indicator=GUARDRAIL"
activity GenerateHelpers(ASTEvidence) -> HelperSet computes "proof=FOUNDATION;indicator=DRIVER"
activity RewriteSource(SourceTree, HelperSet) -> RewrittenTree computes "proof=COHERENCE;indicator=OUTCOME"
activity VerifyIdentity(RewrittenTree) -> IdentityEvidence computes "proof=COHERENCE;indicator=GUARDRAIL"
activity VerifyWriteSet(IdentityEvidence) -> WriteSetEvidence computes "proof=COHERENCE;indicator=DRIVER"
activity CompileProjectedTree(WriteSetEvidence) -> CompiledTree computes "proof=COHERENCE;indicator=OUTCOME"
activity TestProjectedTree(CompiledTree) -> TestEvidence computes "proof=REGRESSION;indicator=GUARDRAIL"
activity ReplayMaterialization(RewrittenTree) -> ReplayTree computes "proof=REGRESSION;indicator=DRIVER"
activity CompareReplay(ReplayTree, TestEvidence) -> ReplayEvidence computes "proof=REGRESSION;indicator=OUTCOME"
activity PublishReceipt(ReplayEvidence) -> RepairReceipt computes "proof=REGRESSION;indicator=GUARDRAIL"
