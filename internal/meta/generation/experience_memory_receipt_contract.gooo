package experiencememoryreceipt
namespace experiencememoryreceipt

entity ExperienceMemoryFingerprint id "gooo://meta-ontology/experience-memory/fingerprint"
entity ExperienceMemoryReceipt id "gooo://meta-ontology/experience-memory/receipt"
entity FreshnessObservation id "gooo://meta-ontology/experience-memory/freshness"
entity OutcomeObservation id "gooo://meta-ontology/experience-memory/outcome"

activity ObserveExperienceMemory(ExperienceMemoryReceipt) -> FreshnessObservation
activity BindExperienceOutcome(ExperienceMemoryReceipt) -> OutcomeObservation
