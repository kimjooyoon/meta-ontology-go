package executionplanprovenancebinding
namespace executionplanprovenancebinding

entity ExecutionPlanProvenanceBinding id "gooo://meta-ontology/execution-plan/provenance-binding"
entity ExecutionPlanObservation id "gooo://meta-ontology/execution-plan/observation"
entity GenerationProvenanceReplay id "gooo://meta-ontology/execution-plan/generation-provenance-replay"

activity BindExecutionPlanProvenance(ExecutionPlanObservation) -> ExecutionPlanProvenanceBinding
activity ObserveGenerationProvenanceReplay(ExecutionPlanProvenanceBinding) -> GenerationProvenanceReplay
