package selfimprovementoutcome
namespace selfimprovementoutcome

entity SelfImprovementOutcomeReceipt id "gooo://meta-ontology/self-improvement-outcome/receipt"
entity CounterexampleObservation id "gooo://meta-ontology/self-improvement-outcome/counterexample"
entity ContractObservation id "gooo://meta-ontology/self-improvement-outcome/contract"
entity RegressionObservation id "gooo://meta-ontology/self-improvement-outcome/regression"
entity AdoptionAuthorityObservation id "gooo://meta-ontology/self-improvement-outcome/adoption-authority"
entity OutcomeReceipt id "gooo://meta-ontology/self-improvement-outcome/result"

activity RecordSelfImprovementOutcome(SelfImprovementOutcomeReceipt) -> OutcomeReceipt
activity VerifyNonAuthorizingAdoption(AdoptionAuthorityObservation) -> OutcomeReceipt
