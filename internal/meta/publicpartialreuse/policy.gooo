package partialchoice
namespace partialchoice

entity Text id "urn:gooo:type:string"
entity Boolean id "urn:gooo:type:boolean"
entity Integer id "urn:gooo:type:integer"
entity Observation id "gooo://partial-reuse/observation/v1" fields {
 field closure_known id "gooo://partial-reuse/observation/closure-known" type boolean required one
 field scope_bounded id "gooo://partial-reuse/observation/scope-bounded" type boolean required one
 field missing_edge id "gooo://partial-reuse/observation/missing-edge" type boolean required one
 field hidden_changed_edge id "gooo://partial-reuse/observation/hidden-changed-edge" type boolean required one
 field impacted id "gooo://partial-reuse/observation/impacted" type boolean required many
 field receipt_states id "gooo://partial-reuse/observation/receipt-states" type string required many
}
entity Assessment id "gooo://partial-reuse/assessment/v1" fields {
 field decision id "gooo://partial-reuse/assessment/decision" type string required one
 field reason id "gooo://partial-reuse/assessment/reason" type string required one
 field stage id "gooo://partial-reuse/assessment/stage" type string required one
 field step id "gooo://partial-reuse/assessment/step" type string required one
 field unknown_class id "gooo://partial-reuse/assessment/unknown-class" type string required one
 field next_operation id "gooo://partial-reuse/assessment/next-operation" type string required one
 field blocked_by id "gooo://partial-reuse/assessment/blocked-by" type string required many
 field execute_partitions id "gooo://partial-reuse/assessment/execute-partitions" type boolean required many
 field test_units_required id "gooo://partial-reuse/assessment/test-units-required" type integer required one
 field test_units_reusable id "gooo://partial-reuse/assessment/test-units-reusable" type integer required one
}

# The host observes graph membership and receipt content. This source chooses
# the outcome. The current public example has exactly two ordered partitions.
# The host must bind execution inputs before generalizing this example to CI.
activity Assess(Observation) -> Assessment id "gooo://partial-reuse/assess/v1" computes `
let result = Assessment{decision: "CLOSED", reason: "AUTHORIZED_UNAFFECTED_PARTITION_RECEIPT_REUSE",
 stage: "", step: "", unknown_class: "", next_operation: "", blocked_by: []string{},
 test_units_required: 0, test_units_reusable: 0, execute_partitions: []bool{}}
if len(input.impacted) != 2 || len(input.receipt_states) != 2 {
 return Unresolved("INPUT", "BIND_ORDERED_PARTITIONS", "PARTITION_OBSERVATION_SHAPE_UNBOUND")
}
if !input.closure_known {
 result = Unresolved("IMPACT", "COMPUTE_CLOSURE", "CHANGED_COMPONENT_IS_UNKNOWN")
} else if !input.scope_bounded {
 result = Unresolved("IMPACT", "BOUND_CLOSURE", "UNBOUNDED_IMPACT_SCOPE")
} else if input.missing_edge {
 result = Unresolved("GRAPH", "VALIDATE_DEPENDENCY_EDGES", "MISSING_DEPENDENCY_EDGE")
}
if input.missing_edge && input.hidden_changed_edge { return Refuted() }
let impacted_count = 0
for i := 0; i < 2; i++ {
 let state = input.receipt_states[i]
 if input.impacted[i] {
  impacted_count = impacted_count + 1
 } else {
  if state == "INVALID" { return Refuted() }
  if result.decision == "CLOSED" {
   if state == "UNAVAILABLE" {
    result = Unresolved("REUSE", "LOAD_PARTITION_RECEIPT", "PARTITION_RECEIPT_UNAVAILABLE")
   } else if state == "TOOL_UNOBSERVED" {
    result = Unresolved("REUSE", "OBSERVE_EXECUTION_TOOL", "PARTITION_EXECUTION_TOOL_UNOBSERVED")
   } else if state == "PARTITION_UNOBSERVED" {
    result = Unresolved("REUSE", "OBSERVE_PARTITION_INPUTS", "PARTITION_INPUT_SCOPE_UNOBSERVED")
   } else if state == "MISSING" {
    result = Unresolved("REUSE", "LOAD_PARTITION_RECEIPT", "MISSING_OR_STALE_PARTITION_RECEIPT")
   } else if state == "STALE" {
    result = Unresolved("REUSE", "VALIDATE_PARTITION_RECEIPT", "STALE_PARTITION_RECEIPT_BINDING")
   } else if state != "VALID" {
    result = Unresolved("REUSE", "LOAD_PARTITION_RECEIPT", "PARTITION_RECEIPT_STATE_UNOBSERVED")
   }
  }
 }
}
if result.decision == "CLOSED" {
 result.execute_partitions = input.impacted
 result.test_units_required = impacted_count
 result.test_units_reusable = 2 - impacted_count
}
return result
`
activity Refuted() -> Assessment id "gooo://partial-reuse/refuted/v1" computes `
return Assessment{decision: "REFUTED", reason: "FAIL_CLOSED_PARTIAL_REUSE_CONTRADICTION",
 stage: "", step: "", unknown_class: "", next_operation: "", blocked_by: []string{},
 test_units_required: 0, test_units_reusable: 0, execute_partitions: []bool{}}
`
activity Unresolved(stage Text, step Text, reason Text) -> Assessment
 id "gooo://partial-reuse/unresolved/v1" computes `
let result = Assessment{decision: "UNKNOWN", reason: reason, stage: stage, step: step,
 unknown_class: "INCOMPLETE_OR_AMBIGUOUS_EVIDENCE", next_operation: "REPAIR_CANONICAL_GRAPH_OR_RECEIPT",
 blocked_by: []string{}, test_units_required: 0, test_units_reusable: 0, execute_partitions: []bool{}}
if reason == "CHANGED_COMPONENT_IS_UNKNOWN" {
 result.blocked_by = []string{"canonical_changed_component", "canonical_dependency_graph"}
} else if reason == "UNBOUNDED_IMPACT_SCOPE" {
 result.blocked_by = []string{"bounded_dependency_closure", "finite_partition_ownership"}
} else if reason == "MISSING_DEPENDENCY_EDGE" {
 result.blocked_by = []string{"canonical_dependency_graph", "complete_source_component_relations"}
} else if reason == "PARTITION_RECEIPT_UNAVAILABLE" {
 result.blocked_by = []string{"exact_partition_binding", "readable_partition_receipt"}
} else if reason == "PARTITION_EXECUTION_TOOL_UNOBSERVED" {
 result.blocked_by = []string{"selected_go_command", "frozen_command_environment"}
} else if reason == "PARTITION_INPUT_SCOPE_UNOBSERVED" {
 result.blocked_by = []string{"module_bytes", "shared_generated_context", "partition_generation_origin"}
} else if reason == "MISSING_OR_STALE_PARTITION_RECEIPT" {
 result.blocked_by = []string{"explicit_reuse_authorization", "immutable_successful_partition_receipt"}
} else if reason == "STALE_PARTITION_RECEIPT_BINDING" {
 result.blocked_by = []string{"exact_partition_binding", "same_test_contract", "same_toolchain"}
} else {
 result.blocked_by = []string{"ordered_partition_observations"}
}
return result
`
