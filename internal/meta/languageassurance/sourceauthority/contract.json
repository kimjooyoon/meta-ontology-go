    "resolution": "INVARIANT_ONLY",
    "enforcement": "BLOCK",
    "reason": "SOURCE_AUTHORITY_EVIDENCE_UNKNOWN"
  },
  "empty_denominator": {
    "observation": "UNKNOWN",
    "resolution": "INVARIANT_ONLY",
    "enforcement": "BLOCK",
    "reason": "SOURCE_AUTHORITY_DENOMINATOR_EMPTY"
  },
  "scope": {
    "accepted_fact_mode": "EXACT_SOURCE_BYTES_ONLY",
    "semantic_interpretation": "CANDIDATE_ONLY",
    "live_url_without_snapshot": "UNKNOWN"
  }
}
