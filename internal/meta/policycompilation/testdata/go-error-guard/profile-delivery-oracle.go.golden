package main

import (
	"bytes"
	"fmt"
	"os"
	"path/filepath"
	"reflect"
	"testing"

	"github.com/kimjooyoon/meta-ontology-go/internal/meta/policycompilation"
)

type goooGuardProfileRejectedOutput struct{}

func (goooGuardProfileRejectedOutput) Write([]byte) (int, error) {
	return 0, os.ErrClosed
}

func TestGoooGuardProfileOutputDelivery(t *testing.T) {
	cases := []struct {
		name     string
		jsonMode bool
		rejected bool
	}{
		{"human-denied", false, true},
		{"json-denied", true, true},
		{"human-success", false, false},
		{"json-success", true, false},
	}
	for _, test := range cases {
		t.Run(test.name, func(t *testing.T) {
			projectRoot, policyPath := writeMetaPolicyProfileFixture(t)
			original, err := os.ReadFile(policyPath)
			if err != nil {
				t.Fatal(err)
			}
			outputDir := filepath.Join(t.TempDir(), "public")
			args := metaPolicyProfileArgs(policyPath, projectRoot, outputDir, "metapolicycompilation", "metapolicycompilation")
			if test.jsonMode {
				args = append(args, "--json")
			}
			var stdout, stderr bytes.Buffer
			var writer interfaceWriter = &stdout
			wantCode := exitOK
			if test.rejected {
				writer = goooGuardProfileRejectedOutput{}
				wantCode = exitFailure
			}
			code := runGenerate(args, OSFileReader{}, SyntaxSourceParser{}, writer, &stderr)
			entries, err := os.ReadDir(outputDir)
			if err != nil {
				t.Fatalf("generated files disappeared after delivery: %v", err)
			}
			names := make([]string, 0, len(entries))
			for _, entry := range entries {
				names = append(names, entry.Name())
			}
			if !reflect.DeepEqual(names, []string{"artifact.json", "generation-manifest.json", "judge.go", "policy.json"}) {
				t.Fatalf("delivery changed generated artifacts: %v", names)
			}
			after, err := os.ReadFile(policyPath)
			if err != nil || !bytes.Equal(after, original) {
				t.Fatalf("delivery changed the input source: %v", err)
			}
			if code != wantCode {
				t.Fatalf("delivery %s exit=%d want=%d stderr=%s", test.name, code, wantCode, stderr.String())
			}
			if !test.rejected {
				requireGoooGuardProfileDeliveredBytes(t, outputDir, test.jsonMode, stdout.Bytes())
			}
		})
	}
}

func requireGoooGuardProfileDeliveredBytes(t *testing.T, directory string, jsonMode bool, got []byte) {
	t.Helper()
	if jsonMode {
		want, err := os.ReadFile(filepath.Join(directory, "generation-manifest.json"))
		if err != nil || !bytes.Equal(got, want) {
			t.Fatalf("JSON delivery differs from the manifest: %v", err)
		}
		return
	}
	root, err := filepath.EvalSymlinks(directory)
	if err != nil {
		t.Fatal(err)
	}
	want := fmt.Sprintf("generated profile: %s\npolicy: %s\nartifact: %s\njudge: %s\nmanifest: %s\n",
		policycompilation.PublicProfileID, filepath.Join(root, "policy.json"),
		filepath.Join(root, "artifact.json"), filepath.Join(root, "judge.go"), filepath.Join(root, "generation-manifest.json"))
	if string(got) != want {
		t.Fatalf("human delivery bytes differ: got=%q want=%q", got, want)
	}
}
