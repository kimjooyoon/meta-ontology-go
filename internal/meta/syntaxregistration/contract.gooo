package syntaxregistration
namespace syntaxregistration

entity RegistrationRequest id "gooo://syntax-registration/request"
entity PinnedRegistrationInput id "gooo://syntax-registration/pinned-input"
entity RegistrationCandidate id "gooo://syntax-registration/candidate"
entity SyntaxCorpus id "gooo://syntax-registration/corpus"
entity NativeRegistry id "gooo://syntax-registration/registry"
entity SyntaxDenominator id "gooo://syntax-registration/syntax-denominator"
entity SyntaxConformance id "gooo://syntax-registration/syntax-conformance"
entity DenominatorAdmission id "gooo://syntax-registration/denominator-admission"
entity DenominatorSelection id "gooo://syntax-registration/denominator-selection"
entity DenominatorDigest id "gooo://syntax-registration/denominator-digest"
entity DenominatorEvidence id "gooo://syntax-registration/denominator-evidence"
entity MigrationConformance id "gooo://syntax-registration/migration-conformance"

activity PinRegistrationExecutionIdentity(RegistrationRequest) -> PinnedRegistrationInput
activity RegisterSyntaxCapability(PinnedRegistrationInput) -> RegistrationCandidate computes "syntax.register:v2"
activity GenerateSyntaxCorpus(PinnedRegistrationInput) -> SyntaxCorpus
activity GenerateNativeRegistry(PinnedRegistrationInput) -> NativeRegistry
activity GenerateSyntaxDenominator(PinnedRegistrationInput) -> SyntaxDenominator
activity GenerateSyntaxConformance(PinnedRegistrationInput) -> SyntaxConformance
activity GenerateDenominatorAdmission(PinnedRegistrationInput) -> DenominatorAdmission
activity GenerateDenominatorSelection(PinnedRegistrationInput) -> DenominatorSelection
activity GenerateDenominatorDigest(PinnedRegistrationInput) -> DenominatorDigest
activity GenerateDenominatorEvidence(PinnedRegistrationInput) -> DenominatorEvidence
activity GenerateMigrationConformance(PinnedRegistrationInput) -> MigrationConformance
