  "positive_fixture": {
    "input": "positive.gooo",
    "expected_output": "positive.golden.gooo",
    "expected_measurements": {
      "input_bytes": 166,
      "expected_output_bytes": 164,
      "semantic_nodes": 3,
      "prov_used_relations": 1,
      "prov_wasGeneratedBy_relations": 1,
      "semantic_relations": 2,
      "unrelated_rewrites": 0,
      "diagnostic_count": 0
    },
    "expected_result": "semantic_fingerprint_equal"
  },
  "counterexamples": [
    {
      "id": "stable-id-drift",
      "input": "positive.drifted.gooo",
