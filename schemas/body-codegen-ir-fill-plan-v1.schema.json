{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimjooyoon/meta-ontology-go/blob/main/schemas/body-codegen-ir-fill-plan-v1.schema.json",
  "title": "Gooo typed IR body-fill experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intent", "hole_id", "candidates", "test_cases"],
  "properties": {
    "schema": { "const": "gooo/body-codegen-ir-fill-plan/v1" },
    "intent": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "hole_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expression"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "expression": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "expected"],
        "properties": {
          "input": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
          "expected": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
        }
      }
    }
  }
}
