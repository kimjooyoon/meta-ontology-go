package filledcollection
namespace filled9571
entity Integer id "urn:gooo:type:integer"
entity Request id "urn:filled9571:request" fields {
 field values id "urn:filled9571:values" type integer required many
 field pick id "urn:filled9571:pick" type integer required one
}
activity Delta(Request) -> Integer id "urn:filled9571:delta" computes "let choices=[]int64{input.values[0],__GOOO_BODY_HOLE_delta__};return choices[input.pick]" assembling {
 source_fill intent "두 번째 원소는 원본 두 값의 증가량을 계산한다" {
  hole "delta"
  candidate "reverse9571" { fill "delta" "input.values[0]-input.values[1]" }
  candidate "forward9571" { fill "delta" "input.values[1]-input.values[0]" }
 }
 value_case "[{\"values\":[31,41],\"pick\":1}]" -> "10"
 holdout_value_case "[{\"values\":[43,61],\"pick\":1}]" -> "18"
}
