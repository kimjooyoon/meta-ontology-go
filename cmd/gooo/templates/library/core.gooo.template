package core
namespace boundedint_core
entity Integer id "boundedint://integer"

activity Normalize(Integer) -> Integer computes `let base = __GOOO_BODY_HOLE_seed__
let increment = __GOOO_BODY_HOLE_step__
return base + increment` assembling {
    source_fill intent "Add one to the input by choosing a base expression and an increment together. 기준식과 증가량을 함께 골라 입력에 1을 더한다." {
        hole "seed"
        hole "step"
        candidate "add_one" {
            fill "seed" "input + 0"
            fill "step" "1"
        }
        candidate "double" {
            fill "seed" "input * 2"
            fill "step" "0"
        }
        candidate "subtract_one" {
            fill "seed" "input - 0"
            fill "step" "-1"
        }
    }
    case "-4" -> "-3"
    case "0" -> "1"
    case "7" -> "8"
}
