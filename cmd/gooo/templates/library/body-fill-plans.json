{
  "schema": "gooo/workspace-body-fill-plans/v1",
  "activities": [
    {
      "package_path": "boundedint/core",
      "activity": "Normalize",
      "plan": {
        "schema": "gooo/body-codegen-ir-fill-plan/v2",
        "intent": "Add one to the input by choosing a base expression and an increment together. 기준식과 증가량을 함께 골라 입력에 1을 더한다.",
        "holes": [
          {"id": "seed"},
          {"id": "step"}
        ],
        "candidates": [
          {"id": "compose", "fills": {"seed": "input + 0", "step": "1"}},
          {"id": "double", "fills": {"seed": "input * 2", "step": "0"}},
          {"id": "subtract", "fills": {"seed": "input - 0", "step": "-1"}}
        ],
        "test_cases": [
          {"input": -4, "expected": -3},
          {"input": 0, "expected": 1},
          {"input": 7, "expected": 8}
        ]
      }
    },
    {
      "package_path": "boundedint/app",
      "activity": "Main",
      "plan": {
        "schema": "gooo/body-codegen-ir-fill-plan/v1",
        "intent": "Return the value produced by the imported normalization activity.",
        "hole_id": "value",
        "candidates": [
          {"id": "add_zero", "expression": "input + 0"},
          {"id": "multiply_zero", "expression": "input * 0"}
        ],
        "test_cases": [
          {"input": -4, "expected": -4},
          {"input": 0, "expected": 0},
          {"input": 7, "expected": 7}
        ]
      }
    }
  ]
}
